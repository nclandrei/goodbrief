0x200-1.jpg 300w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Lebada-02-\u00a9-DanDinu-767x511.jpg 767w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Lebada-02-\u00a9-DanDinu-389x259.jpg 389w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Lebada-02-\u00a9-DanDinu-80x53-1.jpg 80w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Lebada-02-\u00a9-DanDinu-820x546.jpg 820w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Lebada-02-\u00a9-DanDinu-1180x786.jpg 1180w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Lebada-02-\u00a9-DanDinu-150x100.jpg 150w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Lebada-02-\u00a9-DanDinu-779x519.jpg 779w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Lebada-02-\u00a9-DanDinu-600x400.jpg 600w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Lebada-02-\u00a9-DanDinu.jpg 1220w\" ><figcaption class=\"wp-element-caption\">Foto: Rom\u00e2nia S\u0103lbatic\u0103<\/figcaption><\/figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img  loading=\"lazy\"  decoding=\"async\"  width=\"1024\"  height=\"683\"  src=\"data:image\/png;base64,iVBORw0KGgoAAAANSUhEUgAABAAAAAKrAQMAAABV2G3XAAAAA1BMVEUAAP+KeNJXAAAAAXRSTlMAQObYZgAAAAlwSFlzAAAOxAAADsQBlSsOGwAAAGxJREFUeNrtwTEBAAAAwqD1T20MH6AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAOBtYOgAB23VbnQAAAABJRU5ErkJggg==\"  alt=\"\"  class=\"wp-image-416801 pk-lazyload\"  data-pk-sizes=\"auto\"  data-ls-sizes=\"auto, (max-width: 1024px) 100vw, 1024px\"  data-pk-src=\"https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-1024x683.jpg\"  data-pk-srcset=\"https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-1024x683.jpg 1024w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-300x200-1.jpg 300w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-768x512.jpg 768w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-1536x1024-1.jpg 1536w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-390x260.jpg 390w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-80x53-2.jpg 80w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-820x547.jpg 820w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-1180x787.jpg 1180w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-150x100.jpg 150w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-780x520.jpg 780w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-1640x1093.jpg 1640w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu-600x400.jpg 600w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Padurea-Letea-01-\u00a9-DanDinu.jpg 1920w\" ><figcaption class=\"wp-element-caption\">Foto: Rom\u00e2nia Salbatic\u0103<\/figcaption><\/figure>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-15 wp-block-paragraph\">\u201e<strong>\u00cencerc\u0103m \u00een film s\u0103 nu fim moralizatori \u0219i s\u0103 nu ar\u0103t\u0103m cu degetul apropo de ce fac oamenii gre\u0219it<\/strong>. Ci \u00eencerc\u0103m pur \u0219i simplu s\u0103 ar\u0103t\u0103m frumuse\u021be naturii, s\u0103 ar\u0103t\u0103m impactul pe care \u00eel avem asupra ei \u0219i beneficiile pe care le-am avea dac\u0103 am avea mai mult\u0103 grij\u0103 de ea. Ne dorim s\u0103 vin\u0103 dorin\u021ba de a proteja sau a iubi firesc natura&#8221;, mai spune Matei Tru\u021ba. <\/p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-16 wp-block-paragraph\">Coloana sonor\u0103 a filmului are muzic\u0103 creat\u0103 \u0219i interpretat\u0103 de Irina Rimes \u0219i are un stil aparte care se potrive\u0219te \u0219i se \u00eemplete\u0219te cu povestea narat\u0103 de actri\u021ba Medeea Marinescu. <\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"alignright size-large is-resized\"><img  loading=\"lazy\"  decoding=\"async\"  width=\"1024\"  height=\"682\"  src=\"data:image\/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABAQMAAAAl21bKAAAAA1BMVEUAAP+KeNJXAAAAAXRSTlMAQObYZgAAAAlwSFlzAAAOxAAADsQBlSsOGwAAAApJREFUCNdjYAAAAAIAAeIhvDMAAAAASUVORK5CYII=\"  alt=\"\"  class=\"wp-image-416794 pk-lazyload\"  style=\"aspect-ratio:1.501506672406371;width:425px;height:auto\"  data-pk-sizes=\"auto\"  data-ls-sizes=\"auto, (max-width: 1024px) 100vw, 1024px\"  data-pk-src=\"https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-1024x682.jpg\"  data-pk-srcset=\"https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-1024x682.jpg 1024w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-300x200-1.jpg 300w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-767x511.jpg 767w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-389x259.jpg 389w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-820x546.jpg 820w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-80x53-2.jpg 80w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-1180x786.jpg 1180w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-150x100.jpg 150w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-779x519.jpg 779w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu-600x400.jpg 600w, https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Muzica-Irina-Rimes-03-\u00a9-DanDinu.jpg 1220w\" ><\/figure>\n<\/div>\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-17 wp-block-paragraph\">\u201eAm stat de vorb\u0103 cu compozitorul Alexei \u021aurcan, care a f\u0103cut muzica pentru documentarul  Rom\u00e2nia S\u0103lbatic\u0103 \u0219i l-am dus \u00een Delt\u0103 pentru c\u0103 ne-am dorit s\u0103 facem un mic research pentru zona lipoveneasc\u0103, starovereasc\u0103, cum \u00ee\u0219i spun lipovenii. Am \u00eencercat s\u0103 c\u0103ut\u0103m un specific local, ni\u0219te coruri care sunt similare cu zona bulg\u0103reasc\u0103-ucrainian\u0103. Compozitorul a avut aceast\u0103 idee. E un un stil precis de a c\u00e2nta, \u00een care sunt foarte multe ornamente vocale \u0219i s-a g\u00e2ndit la Irina Rimes, apropo de aceast\u0103 zon\u0103 de folclor. Am luat-o ca un fel de provocare. I-am propus ideea noastr\u0103 \u0219i \u00eent\u00e2mplarea a f\u0103cut ca Irina s\u0103 fie un om care s\u0103 cread\u0103 \u00een natur\u0103 \u0219i \u00een proiect, s\u0103 ne ajute gratuit \u0219i chiar s\u0103 fie emo\u021bionat\u0103 de proiect. A considerat c\u0103 este norocoas\u0103 c\u0103 am ales-o noi pentru proiect&#8221;, spune produc\u0103torul filmului. <\/p>\n\n\n\n<h5 id=\"dupa-vizionarea-filmului-invatarea-continua-la-clasa-prin-quiz-uri-interactive\" class=\"wp-block-heading\">Dup\u0103 vizionarea filmului \u00eenv\u0103\u021barea continu\u0103 la clas\u0103 prin quiz-uri interactive<\/h5>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-18 wp-block-paragraph\">Dup\u0103 vizionarea filmului cu clasa, profesorii pot testa cuno\u0219tin\u021bele elevilor, s\u0103 vad\u0103 ce au \u00een\u021beles din documentarul Delta S\u0103lbatic\u0103.  <\/p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-19 wp-block-paragraph\">\u00cen aplica\u021bia <strong><a href=\"https:\/\/romaniasalbatica.ro\/ro\/aplicatia-romania-salbatica\" target=\"_blank\" rel=\"noopener\">Rom\u00e2nia S\u0103lbatic\u0103<\/a><\/strong> ce poate fi desc\u0103rcat\u0103 pe telefon sunt \u00eentreb\u0103ri despre conservare, despre flor\u0103, ecosistem de migra\u021bie care includ Delta Dun\u0103rii.<\/p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-20 wp-block-paragraph\">\u201eNe-am bucurat c\u0103 aplica\u021bia Rom\u00e2nia S\u0103lbatic\u0103 poate fi folosit\u0103 ca un instrument de clas\u0103, la fel \u0219i bro\u0219ura pe care am preg\u0103tit-o \u00een urma filmului s\u0103 fie aplicat\u0103. <strong>Credem foarte mult \u00een educa\u021bie \u0219i credem c\u0103 dac\u0103 vrem s\u0103 facem lumea un loc mai bun, e bine s\u0103 \u00eencepem cu tinerele genera\u021bii, pentru c\u0103, dac\u0103 ele reu\u0219esc s\u0103 fie mai curioase vizavi de natur\u0103, o s\u0103 fie mai atente \u0219i la impactul pe care noi, oamenii \u00eel avem asupra naturii, o s\u0103 \u00een\u021beleag\u0103 c\u0103 \u0219i natura nu e ceva exterior, c\u0103 este parte din noi, natura, \u0219i, ca un pas firesc, va veni iubirea fa\u021b\u0103 de natur\u0103 \u0219i dorin\u021ba de a o proteja<\/strong>&#8222;, spune Matei Tru\u021ba. <\/p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-21 wp-block-paragraph\">Aplica\u021bia este folosit\u0103 de profesori dup\u0103 ce vizioneaz\u0103 documentarele din cadrul proiectului. De exemplu \u00een cazul documentarului Rom\u00e2nia S\u0103lbatic\u0103, peste 450.000 de elevi l-au v\u0103zut \u00een cadrul programului S\u0103pt\u0103m\u00e2na Verde \u0219i \u0218coala Altfel. <\/p>\n\n\n\n<h5 id=\"vezi-trailerul-documentarului-delta-salbatica\" class=\"wp-block-heading\">Vezi trailerul documentarului Delta S\u0103lbatic\u0103<\/h5>\n\n\n\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\n<span class=\"embed-youtube\" style=\"text-align:center; display: block;\"><iframe loading=\"lazy\" class=\"youtube-player\" width=\"640\" height=\"360\" src=\"https:\/\/www.youtube.com\/embed\/HzFltksk_lU?version=3&#038;rel=1&#038;showsearch=0&#038;showinfo=1&#038;iv_load_policy=1&#038;fs=1&#038;hl=ro-RO&#038;autohide=2&#038;wmode=transparent\" allowfullscreen=\"true\" style=\"border:0;\" sandbox=\"allow-scripts allow-same-origin allow-popups allow-presentation allow-popups-to-escape-sandbox\"><\/iframe><\/span>\n<\/div><\/figure>\n","protected":false},"excerpt":{"rendered":"Vizionarea documentarului Delta S\u0103lbatic\u0103 la cinema, \u00eempreun\u0103 cu colegii de clas\u0103 poate fi o activitate inedit\u0103 pentru profesorii \u0219i \u00eenv\u0103\u021b\u0103torii care \u00eenc\u0103 mai caut\u0103 idei pentru S\u0103pt\u0103m\u00e2na Verde sau chiar&hellip;\n","protected":false},"author":190,"featured_media":416880,"comment_status":"open","ping_status":"closed","sticky":true,"template":"","format":"standard","meta":{"inline_featured_image":false,"_jetpack_feature_clip_id":0,"_jetpack_memberships_contains_paid_content":false,"footnotes":"","jetpack_publicize_message":"","jetpack_publicize_feature_enabled":true,"jetpack_social_post_already_shared":true,"jetpack_social_options":{"image_generator_settings":{"template":"highway","default_image_id":0,"font":"","enabled":false},"version":2}},"categories":[26,120637,649,114005,114004,647],"tags":[136943,104523,28876,37947,116750,133810,136940,136942,136941,136939,8021,32343],"class_list":["post-416702","post","type-post","status-publish","format-standard","has-post-thumbnail","category-bcr-pentru-comunitate","category-parinti","category-profesori","category-saptamana-verde","category-scoala-altfel","category-stiri","tag-activitati-gratuite-scoala-altfel","tag-activitati-saptamana-verde","tag-bcr","tag-bcr-pentru-comunitate","tag-cinema-city","tag-delta-salbatica","tag-documentar-delta","tag-intrare-gratuit-cinema-city","tag-irima-rimes","tag-matei-truta","tag-medeea-marinescu","tag-romania-salbatica"],"jetpack_publicize_connections":[],"views":{"total":900,"cached_at":"","cached_date":1793426176},"jetpack_shortlink":"https:\/\/wp.me\/pajIe6-1Kp0","jetpack_sharing_enabled":true,"jetpack_likes_enabled":true,"amp_enabled":true,"jetpack_featured_media_url":"https:\/\/cdn.edupedu.ro\/wp-content\/uploads\/2026\/10\/Delta-Salbatica.jpeg","_links":{"self":[{"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/posts\/416702","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/users\/190"}],"replies":[{"embeddable":true,"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/comments?post=416702"}],"version-history":[{"count":26,"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/posts\/416702\/revisions"}],"predecessor-version":[{"id":416879,"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/posts\/416702\/revisions\/416879"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/media\/416880"}],"wp:attachment":[{"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/media?parent=416702"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/categories?post=416702"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.edupedu.ro\/wp-json\/wp\/v2\/tags?post=416702"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}