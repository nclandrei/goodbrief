<!doctype html>
<html lang="ro">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Programe Naționale de Sănătate Curative – CNAS</title>
<meta name="description" content="Cheltuielile lunare ale programelor naționale curative finanțate de CNAS, pe programe, subprograme și case de asigurări de sănătate.">
<style>
:root{
  color-scheme: dark;
  /* bleumarin instituțional */
  --page:#0b1f3a; --surface:#13294b; --surface-2:#1b3560;
  --ink:#eef2f8; --ink-2:#bcc8db; --muted:#8c9cb6;
  --grid:#223e66; --axis:#34557f; --ring:rgba(255,255,255,.10);
  --accent:#7fb2ee; --accent-wash:rgba(127,178,238,.16); --total:#dce5f2;
  --s1:#3f8ce8; --s2:#d95926; --s3:#199e70; --s4:#c98500; --s5:#d55181; --s6:#16982f; --s0:#6f84a3;
  --seq1:#1e3c66; --seq2:#245897; --seq3:#3f8ce8; --seq4:#86b8f0; --seq5:#d2e5fb;
  --up:#f2a173; --down:#5cc98f; --tile-hi:#0b1f3a;
  --dv0:#4cc38a; --dv1:#2a6b55; --dv2:#4a5a73; --dv3:#8a5638; --dv4:#d9733d; --dv5:#f5b088;
  --dvt0:#0b1f3a; --dvt1:#ffffff; --dvt2:#ffffff; --dvt3:#ffffff; --dvt4:#0b1f3a; --dvt5:#0b1f3a;
  --shadow:0 1px 2px rgba(0,0,0,.18),0 6px 22px rgba(0,0,0,.18);
}
:root[data-theme="light"]{
  color-scheme: light;
  --page:#f3f5f9; --surface:#ffffff; --surface-2:#eef2f8;
  --ink:#10213b; --ink-2:#44546e; --muted:#6b788e;
  --grid:#e2e7ef; --axis:#c3ccda; --ring:rgba(16,33,59,.11);
  --accent:#1c5cab; --accent-wash:rgba(42,120,214,.10); --total:#22324a;
  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100; --s5:#e87ba4; --s6:#008300; --s0:#a3adbd;
  --seq1:#dceafb; --seq2:#9ec5f4; --seq3:#5598e7; --seq4:#256abf; --seq5:#104281;
  --up:#b4531d; --down:#00703c; --tile-hi:#ffffff;
  --dv0:#00703c; --dv1:#a3d9ba; --dv2:#e1e5ec; --dv3:#f7caa9; --dv4:#e9844b; --dv5:#a9471a;
  --dvt0:#ffffff; --dvt1:#10213b; --dvt2:#10213b; --dvt3:#10213b; --dvt4:#10213b; --dvt5:#ffffff;
  --shadow:0 1px 2px rgba(16,33,59,.05),0 4px 18px rgba(16,33,59,.06);
}
:root{--fz0:#22344f;--fz1:#2f5a92;--fz2:#2a83ad;--fz3:#2fae9f;--fz4:#7fd38a;--fz5:#cfe58f;
  --fzl0:#8c9cb6;--fzl1:#eef2f8;--fzl2:#ffffff;--fzl3:#08192f;--fzl4:#08192f;--fzl5:#08192f;--fzstroke:#0b1f3a}
:root[data-theme="light"]{--fz0:#e9edf3;--fz1:#dceafb;--fz2:#9ec5f4;--fz3:#5598e7;--fz4:#256abf;--fz5:#104281;
  --fzl0:#6b788e;--fzl1:#10213b;--fzl2:#10213b;--fzl3:#10213b;--fzl4:#ffffff;--fzl5:#ffffff;--fzstroke:#ffffff}
#fz-map .cty path,#fz-map .cty rect{stroke:var(--fzstroke)}
:root{--pat1:#5fd8c8;--pat2:#2a8fb8;--cost1:#f7c766;--cost2:#e2773f}
:root[data-theme="light"]{--pat1:#2fb5a4;--pat2:#1f6e98;--cost1:#f0b03f;--cost2:#cf5d2a}
:root[data-theme="light"] .js-warn{background:#fff4e5;color:#5a3a00;border-color:#f0c27a}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--page);color:var(--ink);font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased}
.wrap{max-width:1320px;margin:0 auto;padding:0 24px 48px}
header.top{padding:28px 0 18px;display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
h1{font-size:26px;line-height:1.2;margin:6px 0 4px;font-weight:650;letter-spacing:-.01em}
.brand{display:flex;align-items:center;gap:18px}
.brand-txt{display:flex;flex-direction:column;justify-content:center;gap:6px;padding-left:20px;border-left:2px solid var(--accent);min-height:56px}
.inst{font-size:13px;line-height:1.25;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2)}
.brand-txt h1{margin:0;font-size:30px;line-height:1.1}
.logo{flex:none;display:inline-flex;border-radius:10px;background:#fff;padding:6px 8px}
.logo img{display:block;height:56px;width:auto}
:root[data-theme="light"] .logo{background:transparent;padding:6px 0}
.sub{color:var(--ink-2);margin:0;max-width:760px}
.top-actions{display:flex;flex-direction:column;gap:8px;align-items:flex-end}
.theme-btn{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;padding:6px 12px;border-radius:999px}
.theme-btn .ic{font-size:14px;line-height:1}
@media (max-width:640px){.card-h>.seg-toggle{order:-1}
.top-actions{width:100%}}
button,select{font:inherit;color:inherit}
.btn{background:var(--surface);border:1px solid var(--ring);border-radius:8px;padding:7px 12px;cursor:pointer;color:var(--ink-2)}
.btn:hover{background:var(--surface-2);color:var(--ink)}
.btn:focus-visible,select:focus-visible,.row:focus-visible,.tile:focus-visible{outline:2px solid var(--accent);outline-offset:2px}


/* antet + meniu fixate sus la derulare; se compactează după primii pixeli derulați */
.topbar{position:fixed;top:0;left:0;right:0;z-index:40;background:color-mix(in srgb,var(--page) 92%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--ring);transition:box-shadow .2s ease}
.topbar-in{max-width:1320px;margin:0 auto;padding:0 24px}
.topbar.compact{box-shadow:0 8px 24px rgba(0,0,0,.22)}
:root[data-theme="light"] .topbar.compact{box-shadow:0 6px 20px rgba(16,33,59,.10)}
#topspace{height:190px}
.wrap{padding-top:20px}
.card,.sec-h{scroll-margin-top:calc(var(--hdrc,130px) + 14px)}
header.top,.logo,.logo img,.brand-txt,.brand-txt h1,.inst{transition:all .2s ease}
.topbar.compact header.top{padding:10px 0 4px}
.topbar.compact .logo{padding:3px 6px}
.topbar.compact .logo img{height:36px}
.topbar.compact .brand-txt{min-height:36px;gap:2px;padding-left:16px}
.topbar.compact .brand-txt h1{font-size:21px}
.topbar.compact .inst{font-size:11px}
.topbar.compact .filters{padding:6px 0 10px}

/* filtre */
.filters{padding:10px 0 12px;display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center}
.f{display:flex;align-items:center;gap:8px}
.f label{font-size:12px;color:var(--muted);font-weight:600;letter-spacing:.02em}
.f select{background:var(--surface);border:1px solid var(--ring);border-radius:8px;padding:6px 28px 6px 10px;appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 14px) 52%,calc(100% - 9px) 52%;background-size:5px 5px;background-repeat:no-repeat;min-width:0;max-width:100%}
.scope{margin-left:auto;font-size:12.5px;color:var(--ink-2)}

/* carduri */
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}
.card{background:var(--surface);border:1px solid var(--ring);border-radius:14px;padding:18px 20px;box-shadow:var(--shadow);min-width:0}
.card h2{font-size:15px;margin:0;font-weight:620}
.card .hint{color:var(--muted);font-size:12.5px;margin:2px 0 0}
.card-h{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:12px;flex-wrap:wrap}
.card-h>div:first-child{flex:1 1 320px;min-width:0}
.card-h>.seg-toggle{flex:none;margin-left:auto}
.c12{grid-column:span 12}.c8{grid-column:span 8}.c7{grid-column:span 7}.c6{grid-column:span 6}.c5{grid-column:span 5}.c4{grid-column:span 4}.c3{grid-column:span 3}

/* KPI */
.kpi .lab{font-size:12.5px;color:var(--ink-2)}
.kpi .val{font-size:30px;font-weight:640;letter-spacing:-.02em;margin:6px 0 2px;line-height:1.1}
.kpi.hero .val{font-size:48px}
.kpi .unit{font-size:15px;font-weight:500;color:var(--ink-2);margin-left:4px;letter-spacing:0}
.kpi .meta{font-size:12.5px;color:var(--muted)}
.delta{font-weight:600;font-size:12.5px;white-space:nowrap}
.delta.up{color:var(--up)}.delta.down{color:var(--down)}
.spark{display:block;margin-top:10px;width:100%;height:36px}

/* liste cu bare */
.rows{display:flex;flex-direction:column}
.row{display:grid;grid-template-columns:minmax(120px,1.35fr) 2fr 92px 52px 66px;gap:10px;align-items:center;padding:7px 6px;border-radius:8px;cursor:pointer}
.row:hover{background:var(--surface-2)}
.row.sel{background:var(--accent-wash)}
.row .nm{display:flex;align-items:center;gap:8px;min-width:0}
.row .nm span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sw{width:10px;height:10px;border-radius:3px;flex:none}
.track{height:12px;position:relative}
.bar{position:absolute;left:0;top:0;bottom:0;border-radius:0 4px 4px 0;min-width:2px}
.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.pct{color:var(--muted);font-size:12.5px}
.rows-h{display:grid;grid-template-columns:minmax(120px,1.35fr) 2fr 92px 52px 66px;gap:10px;padding:0 6px 6px;font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid var(--grid);margin-bottom:4px}
.rows-h div:nth-child(n+3){text-align:right}
.row .chev{margin-left:auto;color:var(--muted);font-size:11px;flex:none;transition:transform .15s}
.row.sel .chev{transform:rotate(90deg);color:var(--ink)}
.pdetail{margin:2px 0 10px 18px;padding:14px 16px;background:var(--surface-2);border-radius:10px;border-left:3px solid var(--accent);animation:pd .18s ease-out}
@keyframes pd{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
.pdetail .pd-h{font-size:12.5px;color:var(--ink-2);margin-bottom:10px}
.pdetail .pd-stats{display:flex;flex-wrap:wrap;gap:8px 26px;margin-bottom:12px}
.pdetail .pd-stats div{font-size:12px;color:var(--muted)}
.pdetail .pd-stats b{display:block;font-size:17px;color:var(--ink);font-weight:640;letter-spacing:-.01em}
.pdetail .pd-sec{font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:12px 0 4px}
.pdetail .row{padding:5px 6px}
.pdetail .row:hover{background:var(--surface)}
.pdetail .pd-act{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.pdetail .btn{padding:5px 10px;font-size:12.5px}
.flash{animation:fl 1.1s ease-out}
@keyframes fl{0%{box-shadow:0 0 0 3px var(--accent)}100%{box-shadow:var(--shadow)}}
.row.static{cursor:default}
.row.static:hover{background:transparent}
.sub-rows .row,.sub-rows .rows-h{grid-template-columns:minmax(140px,1.6fr) 1.6fr 92px 52px 66px}
#sub-rows .row .nm span{white-space:normal;overflow:visible;line-height:1.3}
#jud-rows .row,#jud-rows .rows-h{grid-template-columns:minmax(110px,1.2fr) 1.4fr 92px 52px 66px}

/* legende */
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12.5px;color:var(--ink-2)}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.legend .ln{width:14px;height:2px;border-radius:2px;vertical-align:3px}

/* svg */
svg{display:block;overflow:visible}
.ax text{fill:var(--muted);font-size:11px;font-variant-numeric:tabular-nums}
.gridl{stroke:var(--grid);stroke-width:1;shape-rendering:crispEdges}
.base{stroke:var(--axis);stroke-width:1;shape-rendering:crispEdges}
.chart{position:relative}
.tip{position:fixed;z-index:50;pointer-events:none;background:var(--surface);border:1px solid var(--ring);border-radius:10px;padding:9px 11px;box-shadow:0 6px 24px rgba(0,0,0,.14);font-size:12.5px;min-width:150px;max-width:280px;opacity:0;transition:opacity .08s}
.tip.on{opacity:1}
.tip .t{color:var(--muted);font-size:11.5px;margin-bottom:4px}
.tip .v{font-weight:650;font-size:14px;color:var(--ink)}
.tip .r{display:flex;gap:8px;align-items:center;justify-content:space-between;margin-top:2px}
.tip .r span:first-child{color:var(--ink-2)}
.tip .k{display:inline-block;width:12px;height:2px;border-radius:2px;margin-right:6px;vertical-align:3px}

/* hartă */
.map-wrap{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:20px;align-items:start}
.cty path,.cty rect{stroke:var(--surface);stroke-width:1.2px;vector-effect:non-scaling-stroke;cursor:pointer;stroke-linejoin:round}
.cty:hover .bmk,.cty.sel .bmk,.cty:hover path,.cty:hover rect,.cty.sel path,.cty.sel rect{stroke:var(--ink);stroke-width:2px}
.cty:focus-visible{outline:none}.cty:focus-visible path,.cty:focus-visible rect{stroke:var(--accent);stroke-width:2.5px}
#map text{font-weight:600}
.tile rect{stroke:var(--surface);stroke-width:2;cursor:pointer;transition:opacity .1s}
.tile:hover rect,.tile.sel rect{stroke:var(--ink);stroke-width:2}
.tile text{font-size:11px;font-weight:600;pointer-events:none}
.seq-leg{display:flex;align-items:center;gap:0;margin-top:10px;font-size:11.5px;color:var(--muted);flex-wrap:wrap}
.seq-leg{align-items:flex-start;row-gap:8px}
.map-note{margin-top:14px;padding:12px 14px;background:var(--surface-2);border-radius:10px;font-size:12.5px;line-height:1.55;color:var(--ink-2)}
.map-note b{color:var(--ink);font-weight:600}
.map-note p{margin:0 0 6px}.map-note p:last-child{margin:0}
.seq-leg .b{display:flex;flex-direction:column;gap:3px;min-width:58px;max-width:96px;padding-right:6px}
.seq-leg .b span{line-height:1.25}
.seq-leg .b i{height:10px;display:block;margin-right:2px}
#cv-card.c12 #cv-right{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:12px 40px;align-items:start}
@media (max-width:900px){#cv-card.c12 #cv-right{grid-template-columns:1fr}}
.card-tools{display:flex;gap:8px;align-items:center;margin-left:auto;flex-wrap:wrap;justify-content:flex-end}
.btn-csv{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;padding:6px 11px;white-space:nowrap}
.btn-csv svg{width:14px;height:14px}
.seg-toggle{display:inline-flex;border:1px solid var(--ring);border-radius:8px;overflow:hidden}
.seg-toggle button{border:0;background:var(--surface);padding:5px 10px;cursor:pointer;color:var(--ink-2);font-size:12.5px}
.seg-toggle button.on{background:var(--accent-wash);color:var(--ink);font-weight:600}

/* rețeaua de unități nominalizate */
.fz-act{flex:1 1 100%;min-width:0;max-width:100%}
.fz-act select{max-width:min(620px,100%);text-overflow:ellipsis}
.fz-tools{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:8px}
.fz-tools .btn-csv{margin-left:auto}
.fz-tools input{flex:1 1 140px;min-width:0;background:var(--surface);border:1px solid var(--ring);border-radius:8px;padding:6px 10px;color:var(--ink);font:inherit}
.fz-tools input:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.fz-tools span{font-size:12.5px;color:var(--muted)}
#fz-rows{max-height:520px;overflow:auto;padding-right:4px}
#fz-rows .row,#fz-rows .rows-h{grid-template-columns:minmax(0,1fr) 110px 64px}
#fz-rows .row .nm{align-items:flex-start}
#fz-rows .row .nm span{white-space:normal;overflow:visible;line-height:1.3}
#fz-rows .row .sub2{display:block;color:var(--muted);font-size:11.5px;margin-top:1px}
#fz-rows .rows-h{position:sticky;top:0;background:var(--surface);z-index:1}
#fz-rows .num{font-size:12.5px;color:var(--ink-2)}
.fz-back{display:block;width:100%;text-align:left;margin:0 0 8px;font-size:12.5px;color:var(--accent);border-color:var(--accent-wash)}
#fz-rows .row.static .num:nth-child(2){text-align:right}
.fz-gen{margin-top:12px;padding:10px 12px;border-radius:10px;background:var(--surface-2);font-size:12.5px;color:var(--ink-2);line-height:1.5}
.fz-gen b{color:var(--ink);font-weight:600}
.fz-gen ul{margin:4px 0 0;padding-left:18px}
@media (max-width:640px){#fz-rows .row,#fz-rows .rows-h{grid-template-columns:minmax(0,1fr) 92px 52px}.fz-act{margin-left:0;width:100%}.fz-act select{flex:1}}

/* avertizare fără JavaScript */
.js-warn{background:#3a2c12;color:#f7dfb0;border:1px solid #8a6a2a;border-radius:12px;padding:14px 16px;margin:0 0 16px;font-size:14px;line-height:1.5}
.js-warn strong{display:block;margin-bottom:4px}
.js-ok .js-warn{display:none}
#js-err{display:block;margin-top:6px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}

/* secțiuni și sinteză */
.sec-h{display:flex;gap:14px;align-items:center;margin:22px 0 2px;padding-top:6px}
.sec-h .sec-n{flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:14px;background:var(--accent-wash);color:var(--accent);border:1px solid var(--ring)}
.sec-h h2{margin:0;font-size:18px;font-weight:650}
.sec-h p{margin:2px 0 0;color:var(--ink-2);font-size:13px}
.syn{background:linear-gradient(180deg,var(--surface-2),var(--surface))}
.syn-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.syn-i{background:var(--surface);border:1px solid var(--ring);border-radius:12px;padding:14px 16px}
.syn-i .cat{font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:600;display:flex;justify-content:space-between;gap:8px}
.syn-i .tag{letter-spacing:0;text-transform:none;font-weight:600;font-size:11.5px;border-radius:999px;padding:1px 8px}
.syn-i .tag.warn{background:rgba(242,161,115,.16);color:var(--up)}
.syn-i .tag.ok{background:rgba(92,201,143,.14);color:var(--down)}
.syn-i .tag.info{background:var(--accent-wash);color:var(--accent)}
.syn-i .big{font-size:24px;font-weight:650;margin:6px 0 4px;letter-spacing:-.01em}
.syn-i p{margin:0;color:var(--ink-2);font-size:13px;line-height:1.5}
@media (max-width:1080px){.syn-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:640px){.syn-grid{grid-template-columns:1fr}.sec-h h2{font-size:16px}}

/* angajat vs plătit, cost-volum */
.ap-wrap{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:28px;align-items:start}
.ap-stats{display:flex;flex-wrap:wrap;gap:10px 34px;margin:-2px 0 16px}
.ap-stats div{font-size:12px;color:var(--muted)}
.ap-stats b{display:block;font-size:22px;color:var(--ink);font-weight:640;letter-spacing:-.01em;margin-bottom:1px}
.ap-tbl th,.ap-tbl td{padding:6px 6px}
#eff-tbl td:first-child{white-space:normal;min-width:130px}
#eff-card .ap-wrap{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.ap-tbl tr.cur td{background:var(--accent-wash)}
.ap-tbl td.neg,#tbl td.neg{color:var(--down)} .ap-tbl td.pos,#tbl td.pos{color:var(--up)}
.u-over{color:var(--up)!important}.u-under{color:var(--accent)!important}
#al-right .row,#al-right .rows-h{grid-template-columns:minmax(130px,1.4fr) 1.4fr 70px 58px 74px}
#al-right .row .nm span{white-space:normal;overflow:visible;line-height:1.3}
.utrack{height:12px;position:relative;background:color-mix(in srgb,var(--grid) 70%,transparent);border-radius:3px}
.utrack .bar{border-radius:3px}
.utrack .m100{position:absolute;top:-3px;bottom:-3px;width:2px;background:var(--ink-2);border-radius:1px}
@media (max-width:640px){#al-right .row,#al-right .rows-h{grid-template-columns:minmax(0,1.3fr) 64px 56px}
  #al-right .row>:nth-child(2),#al-right .rows-h>:nth-child(2),#al-right .row>:nth-child(5),#al-right .rows-h>:nth-child(5){display:none}
  #al-right .row>:nth-child(4),#al-right .rows-h>:nth-child(4){display:block}}
.cv-row{display:grid;grid-template-columns:minmax(0,1.6fr) 1fr 84px 52px;gap:10px;align-items:center;padding:6px 4px;font-size:13px}
.cv-row .track{height:10px}
.cv-sum{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 16px;margin-top:14px;padding-top:12px;border-top:1px solid var(--grid);font-size:13px}
.cv-sum b{font-variant-numeric:tabular-nums;text-align:right}
.cv-sum .tot{font-weight:650;font-size:14px}
@media (max-width:1080px){.ap-wrap,#eff-card .ap-wrap{grid-template-columns:minmax(0,1fr)}}
@media (max-width:640px){.cv-row{grid-template-columns:minmax(0,1.4fr) 76px 48px}.cv-row .track{display:none}.ap-stats b{font-size:19px}}

/* bolnavi */
.bol-wrap{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:28px;align-items:start}
.bol-sec .pal{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:7px;vertical-align:0}
.bol-sec{font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:0 0 6px;font-weight:600}
#bol-left .row,#bol-left .rows-h{grid-template-columns:minmax(120px,1.3fr) 1.3fr 86px 96px 62px}
#bol-right .row,#bol-right .rows-h{grid-template-columns:minmax(0,1.9fr) 104px 100px}
#bol-right .rows-h div{white-space:nowrap}
#bol-right .rows-h div:nth-child(n+2){text-align:right}
#bol-right .row .nm span{white-space:normal;overflow:visible;line-height:1.3}
#bol-right .row .sub2{display:block;color:var(--muted);font-size:11.5px}
.bol-note{font-size:12px;color:var(--muted);margin-top:10px;line-height:1.5}
.bol-charts{display:grid;grid-template-columns:1fr 1fr;gap:18px}
@media (max-width:1080px){.bol-wrap{grid-template-columns:minmax(0,1fr)}}
@media (max-width:640px){.bol-charts{grid-template-columns:1fr}
  #bol-left .row,#bol-left .rows-h{grid-template-columns:minmax(0,1.3fr) 76px 88px}
  #bol-left .row>:nth-child(2),#bol-left .rows-h>:nth-child(2),#bol-left .row>:nth-child(5),#bol-left .rows-h>:nth-child(5){display:none}
  #bol-right .row,#bol-right .rows-h{grid-template-columns:minmax(0,1.5fr) 90px 82px}
  #bol-left .row>:nth-child(4),#bol-left .rows-h>:nth-child(4){display:block}}

/* tabel */
.tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{padding:7px 10px;text-align:right;white-space:nowrap;border-bottom:1px solid var(--grid)}
th:first-child,td:first-child{text-align:left;position:sticky;left:0;background:var(--surface)}
thead th{font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;font-weight:600}
tbody td{font-variant-numeric:tabular-nums}
tbody tr:hover td{background:var(--surface-2)}
tfoot td{font-weight:650;border-top:1px solid var(--axis);border-bottom:0}
td .yoy{display:block;font-size:11px;color:var(--muted)}
.empty{color:var(--muted);font-size:13px;padding:24px 0;text-align:center}

footer{color:var(--muted);font-size:12px;margin-top:22px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}

@media (max-width:1080px){.c8,.c7,.c6,.c5,.c4{grid-column:span 12}.c3{grid-column:span 6}.map-wrap{grid-template-columns:minmax(0,1fr)}}
@media (max-width:640px){
  .wrap{padding:0 16px 40px}
  h1{font-size:21px}
  .brand{gap:12px}
  .brand-txt{padding-left:12px;gap:4px;min-height:40px}
  .inst{font-size:10.5px;letter-spacing:.06em}
  .brand-txt h1{font-size:20px}
  .logo img{height:40px}
  .c3{grid-column:span 12}
  .kpi.hero .val{font-size:38px}
  .filters{gap:8px 12px}
  .scope{margin-left:0;width:100%}
  .topbar-in{padding:0 16px}
  .topbar.compact header.top{padding:8px 0 2px}
  .topbar.compact .inst,.topbar.compact .scope{display:none}
  .topbar.compact .logo img{height:30px}
  .topbar.compact .brand-txt{min-height:30px}
  .topbar.compact .brand-txt h1{font-size:17px}
  .topbar.compact .theme-btn{padding:4px 9px}
  .f{max-width:100%;min-width:0}
  .f select{flex:1 1 auto;min-width:0;text-overflow:ellipsis}
  .topbar.compact .top-actions{display:none}
  .topbar.compact .filters{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:6px;padding:4px 0 8px}
  .topbar.compact .f label{display:none}
  .topbar.compact .f select{width:100%;padding-top:5px;padding-bottom:5px}
  .topbar.compact #f-sub-wrap{grid-column:1/-1}
  .row,.rows-h,.sub-rows .row,.sub-rows .rows-h,#jud-rows .row,#jud-rows .rows-h{grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) 72px 58px;gap:8px}
  .row>:nth-child(4),.rows-h>:nth-child(4){display:none}
  #prog-rows .row,#prog-rows .rows-h{grid-template-columns:minmax(0,1fr) 72px 58px}
  #prog-rows .row>:nth-child(2),#prog-rows .rows-h>:nth-child(2){display:none}
  .card{padding:16px}
}
@media print{
  .filters,.btn,.seg-toggle{display:none!important}
  .topbar{position:static;box-shadow:none;backdrop-filter:none;border:0}
  #topspace{display:none}
  body{background:#fff;color:#111}
  .card{box-shadow:none;break-inside:avoid}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="topbar" id="topbar"><div class="topbar-in">
  <header class="top">
    <div class="brand">
      <span class="logo"><img src="data:image/png;base64," alt="CNAS – Casa Națională de Asigurări de Sănătate" width="101" height="56"></span>
      <div class="brand-txt">
        <span class="inst">Casa Națională de Asigurări de Sănătate</span>
        <h1>Programe Naționale de Sănătate Curative</h1>
      </div>
    </div>
    <div class="top-actions">
      <button class="btn theme-btn" id="btn-theme" type="button" aria-label="Schimbă varianta de culori"></button>
    </div>
  </header>
  <nav class="filters" aria-label="Filtre">
    <div class="f"><label for="f-an">An</label><select id="f-an"></select></div>
    <div class="f"><label for="f-prog">Program</label><select id="f-prog"></select></div>
    <div class="f" id="f-sub-wrap" style="display:none"><label for="f-sub">Subprogram</label><select id="f-sub"></select></div>
    <div class="scope" id="scope"></div>
  </nav>
</div></div>
<div id="topspace" aria-hidden="true"></div>
<div class="wrap">

  <div id="js-warn" class="js-warn" role="alert">
    <strong>Graficele nu se pot afișa în această previzualizare.</strong>
    Pagina folosește JavaScript, care nu rulează în previzualizările de fișiere (e-mail, WhatsApp, aplicația Fișiere, previzualizarea din aplicații de chat).
    Deschideți pagina într-un browser – Chrome, Safari, Edge – sau de pe adresa ei din intranet.
    <span id="js-err"></span>
  </div>

  <main class="grid">
    <div class="sec-h c12"><span class="sec-n">1</span><div><h2>Plăți efectuate</h2></div></div>
    <section class="card kpi hero c3" id="k1"></section>
    <section class="card kpi c3" id="k2"></section>
    <section class="card kpi c3" id="k3"></section>
    <section class="card kpi c3" id="k4"></section>

    <section class="card c12">
      <div class="card-h">
        <div><h2>Evoluția anuală a plăților</h2><p class="hint" id="trend-hint"></p></div>
        <div class="legend" id="trend-leg"></div>
      </div>
      <div class="chart" id="trend"></div>
    </section>

    <div class="sec-h c12"><span class="sec-n">2</span><div><h2>Structura plăților</h2></div></div>
    <section class="card c7">
      <div class="card-h">
        <div><h2>Plăți pe programe</h2><p class="hint" id="prog-hint">Clic pe un program pentru a filtra întreaga pagină</p></div>
      </div>
      <div class="rows" id="prog-rows"></div>
    </section>

    <section class="card c5">
      <div class="card-h">
        <div><h2>Structura plăților pe ani</h2><p class="hint">Ponderea programelor în totalul plăților, inclusiv cost-volum · %</p></div>
      </div>
      <div class="legend" id="mix-leg" style="margin-bottom:10px"></div>
      <div class="chart" id="mix"></div>
    </section>

    <section class="card c7" id="sub-card">
      <div class="card-h">
        <div><h2 id="sub-title">Subprograme</h2><p class="hint" id="sub-hint"></p></div>
      </div>
      <div class="rows sub-rows" id="sub-rows"></div>
    </section>

    <section class="card c5" id="cv-card">
      <div class="card-h">
        <div><h2 id="cv-title">Cost-volum</h2><p class="hint" id="cv-hint"></p></div>
      </div>
      <div id="cv-right"></div>
    </section>

    <div class="sec-h c12"><span class="sec-n">3</span><div><h2>Bolnavi tratați</h2></div></div>
    <section class="card c12" id="bol-card">
      <div class="card-h">
        <div><h2 id="bol-title">Bolnavi tratați</h2><p class="hint" id="bol-hint"></p></div>
        <div class="card-tools"><div class="seg-toggle" role="group" aria-label="Perioada pentru bolnavi" id="bol-per"></div><button class="btn btn-csv" type="button" id="csv-bol" title="Descarcă bolnavii în format CSV"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0L4.8 6.8M8 10l3.2-3.2M3 12.5h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>CSV</button></div>
      </div>
      <div class="bol-wrap">
        <div id="bol-left"></div>
        <div id="bol-right"></div>
      </div>
    </section>

    <div class="sec-h c12"><span class="sec-n">4</span><div><h2>Furnizori de servicii medicale</h2></div></div>
    <section class="card c12" id="fz-card">
      <div class="card-h">
        <div><h2 id="fz-title">Furnizori de servicii medicale aflați în relație contractuală cu CAS</h2><p class="hint" id="fz-hint"></p></div>
        <div class="f fz-act" id="fz-act-wrap"><label for="fz-act">Activitate</label><select id="fz-act"></select></div>
      </div>
      <div class="map-wrap">
        <div><div class="chart" id="fz-map"></div></div>
        <div><div class="fz-tools"><input type="search" id="fz-q" placeholder="Caută furnizor sau localitate" aria-label="Caută furnizor sau localitate"><span id="fz-count"></span><button class="btn btn-csv" type="button" id="csv-fz" title="Descarcă lista de furnizori în format CSV"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0L4.8 6.8M8 10l3.2-3.2M3 12.5h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>CSV</button></div><div class="rows" id="fz-rows"></div></div>
      </div>
    </section>

    <div class="sec-h c12"><span class="sec-n">5</span><div><h2>Tabel plăți pe ani</h2></div></div>
    <section class="card c12">
      <div class="card-h">
        <div><h2 id="tbl-title">Tabel program × an</h2><p class="hint" id="tbl-hint"></p></div>
        <div class="card-tools">
        <div class="seg-toggle" role="group" aria-label="Indicator tabel" id="tbl-mode">
          <button type="button" data-t="tot" class="on">Total plăți</button><button type="button" data-t="prog">Plăți program</button><button type="button" data-t="cv">Cost-volum</button>
        </div>
        <button class="btn btn-csv" type="button" id="csv-tbl" title="Descarcă tabelul în format CSV"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0L4.8 6.8M8 10l3.2-3.2M3 12.5h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>CSV</button>
        </div>
      </div>
      <div class="tbl-wrap"><table id="tbl"></table></div>
    </section>

  </main>
</div>
<div class="tip" id="tip" role="tooltip"></div>

