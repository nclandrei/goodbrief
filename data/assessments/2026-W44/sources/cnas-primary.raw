<script>
(function(){
'use strict';
const D = JSON.parse(document.getElementById('date-dashboard').textContent);
const PROG = D.programe;
const PID = PROG.map(p=>p.id);
const PNAME = Object.fromEntries(PROG.map(p=>[p.id,p.nume]));
const PFULL = Object.fromEntries(PROG.map(p=>[p.id,p.complet]));
const LUNI = ['ianuarie','februarie','martie','aprilie','mai','iunie','iulie','august','septembrie','octombrie','noiembrie','decembrie'];
const LS = ['ian.','feb.','mar.','apr.','mai','iun.','iul.','aug.','sep.','oct.','nov.','dec.'];
const JN = {ALBA:'Alba',ARAD:'Arad',ARGES:'Argeș',BACAU:'Bacău',BIHOR:'Bihor',BISTRITA:'Bistrița-Năsăud',BOTOSANI:'Botoșani',BRASOV:'Brașov',BRAILA:'Brăila',BUZAU:'Buzău',CARAS:'Caraș-Severin',CALARASI:'Călărași',CLUJ:'Cluj',CONSTANTA:'Constanța',COVASNA:'Covasna',DAMBOVITA:'Dâmbovița',DOLJ:'Dolj',GALATI:'Galați',GIURGIU:'Giurgiu',GORJ:'Gorj',HARGHITA:'Harghita',HUNEDOARA:'Hunedoara',IALOMITA:'Ialomița',IASI:'Iași',ILFOV:'Ilfov',MARAMURES:'Maramureș',MEHEDINTI:'Mehedinți',MURES:'Mureș',NEAMT:'Neamț',OLT:'Olt',PRAHOVA:'Prahova','SATU-MARE':'Satu Mare',SALAJ:'Sălaj',SIBIU:'Sibiu',SUCEAVA:'Suceava',TELEORMAN:'Teleorman',TIMIS:'Timiș',TULCEA:'Tulcea',VASLUI:'Vaslui',VALCEA:'Vâlcea',VRANCEA:'Vrancea',BUCURESTI:'București',AOPSNAJ:'AOPSNAJ'};
// grilă aproximativă a județelor (coloană, rând)
const GRID = {'SATU-MARE':[2,0,'SM'],MARAMURES:[3,0,'MM'],SUCEAVA:[5,0,'SV'],BOTOSANI:[6,0,'BT'],
 BIHOR:[1,1,'BH'],SALAJ:[2,1,'SJ'],CLUJ:[3,1,'CJ'],BISTRITA:[4,1,'BN'],NEAMT:[5,1,'NT'],IASI:[6,1,'IS'],
 ARAD:[1,2,'AR'],ALBA:[2,2,'AB'],MURES:[3,2,'MS'],HARGHITA:[4,2,'HR'],BACAU:[5,2,'BC'],VASLUI:[6,2,'VS'],
 TIMIS:[0,3,'TM'],HUNEDOARA:[1,3,'HD'],SIBIU:[2,3,'SB'],BRASOV:[3,3,'BV'],COVASNA:[4,3,'CV'],VRANCEA:[5,3,'VN'],GALATI:[6,3,'GL'],
 CARAS:[0,4,'CS'],GORJ:[1,4,'GJ'],VALCEA:[2,4,'VL'],ARGES:[3,4,'AG'],PRAHOVA:[4,4,'PH'],BUZAU:[5,4,'BZ'],BRAILA:[6,4,'BR'],TULCEA:[7,4,'TL'],
 MEHEDINTI:[0,5,'MH'],DOLJ:[1,5,'DJ'],OLT:[2,5,'OT'],DAMBOVITA:[3,5,'DB'],ILFOV:[4,5,'IF'],IALOMITA:[5,5,'IL'],CONSTANTA:[6,5,'CT'],
 TELEORMAN:[2,6,'TR'],GIURGIU:[3,6,'GR'],BUCURESTI:[4,6,'B'],CALARASI:[5,6,'CL']};
const MAP = JSON.parse(document.getElementById('harta-romania').textContent);
const LBL_OFF = {ILFOV:[0,-30],CONSTANTA:[8,0],TULCEA:[10,0],GIURGIU:[0,10],CALARASI:[0,4],CARAS:[0,0]};
// culoare fixă pe program (entitate), restul în gri
const COLORED = ['onco','diabet','dializa','rare','cardio','hemo'];
const pcol = id => { const i = COLORED.indexOf(id); return i<0 ? 'var(--s0)' : `var(--s${i+1})`; };

const fmtN = (v,d=1)=> new Intl.NumberFormat('ro-RO',{minimumFractionDigits:d,maximumFractionDigits:d}).format(v);
const mil = v => !isFinite(v)?'n.d.': fmtN(v/1e6, Math.abs(v)>=1e8?1:(Math.abs(v)>=1e6?1:2));
function money(v){ // text compact
  if(!isFinite(v)) return 'n.d.';
  const a=Math.abs(v);
  if(a>=1e9) return fmtN(v/1e9,2)+' mld. lei';
  if(a>=1e6) return fmtN(v/1e6,1)+' mil. lei';
  if(a>=1e3) return fmtN(v/1e3,0)+' mii lei';
  return fmtN(v,0)+' lei';
}
function moneyParts(v){
  if(!isFinite(v)) return ['n.d.',''];
  const a=Math.abs(v);
  if(a>=1e9) return [fmtN(v/1e9,2),'mld. lei'];
  if(a>=1e6) return [fmtN(v/1e6,1),'mil. lei'];
  if(a>=1e3) return [fmtN(v/1e3,0),'mii lei'];
  return [fmtN(v,0),'lei'];
}
const pct = (v,d=1)=> (v>0?'+':'')+fmtN(v*100,d)+'%';
const sh = (v,d=1)=> fmtN(v*100,d)+'%';
const sum = a => a.reduce((s,x)=>s+x,0);
const el = (tag,attrs={},kids=[])=>{const e=document.createElement(tag);for(const k in attrs){if(k==='text')e.textContent=attrs[k];else if(k==='style')e.setAttribute('style',attrs[k]);else if(k.startsWith('on'))e.addEventListener(k.slice(2),attrs[k]);else e.setAttribute(k,attrs[k]);}(Array.isArray(kids)?kids:[kids]).forEach(c=>c!=null&&e.append(c));return e;};
const NS='http://www.w3.org/2000/svg';
const s = (tag,attrs={})=>{const e=document.createElementNS(NS,tag);for(const k in attrs)e.setAttribute(k,attrs[k]);return e;};

// ---------- date: plăți efectuate (credite bugetare), inclusiv cost-volum ----------
const PL = D.plati || {perioade:[],total:[],prog:{},sub:{},cv:{total:[],prog:{},det:{}}};
const PLP = PL.perioade, NK = PLP.length;
const CVP = PL.cv || {total:[],prog:{},det:{}};
const CVL = 'Medicamente în contracte cost-volum';     // „subprogram” pentru plățile cost-volum ale programului
const PRGL = 'Program (fără cost-volum)';               // programele fără subprograme, dar cu cost-volum
const FULL = PLP.map((p,k)=>p.luni===12?k:-1).filter(k=>k>=0);
const K0 = FULL[0], KN = FULL[FULL.length-1];
const hasCV = p => p==='all' ? true : (CVP.prog[p]||[]).some(v=>v>0);
const pProg = (k,p) => p==='all' ? sum(PID.map(q=>pProg(k,q))) : (((PL.prog[p]||[])[k])||0);
const pCV   = (k,p) => p==='all' ? sum(PID.map(q=>pCV(k,q)))   : (((CVP.prog[p]||[])[k])||0);
const pTot  = (k,p) => pProg(k,p)+pCV(k,p);
const subsOf = p => { if(p==='all') return []; const s0=Object.keys(PL.sub[p]||{}); const out=s0.length?s0.slice():(hasCV(p)?[PRGL]:[]); if(hasCV(p)) out.push(CVL); return out; };
const hasSubs = p => subsOf(p).length>1;
function val(k,p,sub){
  if(p==='all') return pTot(k,'all');
  if(!sub || sub==='all' || !hasSubs(p)) return pTot(k,p);
  if(sub===CVL) return pCV(k,p);
  if(sub===PRGL) return pProg(k,p);
  const t=(PL.sub[p]||{})[sub]; return t ? (t[k]||0) : 0;
}
const prevK = k => (k>0 && PLP[k].luni===12 && PLP[k-1].luni===12) ? k-1 : null;
const perL = k => PLP[k].luni===12 ? PLP[k].an : PLP[k].eticheta;
const perShort = k => PLP[k].luni===12 ? PLP[k].an : (PLP[k].luni===6 ? 'S1 '+PLP[k].an : PLP[k].eticheta);
const cagrK = (a,b,v0,v1) => (v0>0&&v1>0&&b>a) ? Math.pow(v1/v0,1/(+PLP[b].an-+PLP[a].an))-1 : null;
const colOf = p => p==='all' ? 'var(--accent)' : (pcol(p)==='var(--s0)' ? 'var(--total)' : pcol(p));

// ---------- stare ----------
const st = {k: KN!=null?KN:NK-1, prog:'all', sub:'all', jud:'all', bolAll:false, tbl:'tot'};
Object.defineProperty(st,'an',{get(){return PLP[st.k].an;}});

// ---------- filtre ----------
// variantă de culori (întunecat implicit), memorată local
const themeBtn=document.getElementById('btn-theme');
function applyTheme(t){ if(t==='light') document.documentElement.setAttribute('data-theme','light'); else document.documentElement.removeAttribute('data-theme');
  themeBtn.innerHTML=''; themeBtn.append(el('span',{class:'ic','aria-hidden':'true',text:t==='light'?'☾':'☀'}),document.createTextNode(t==='light'?'Varianta întunecată':'Varianta luminoasă')); }
let THEME='dark'; try{ THEME=localStorage.getItem('cnas-dash-tema')||'dark'; }catch(e){}
applyTheme(THEME);
themeBtn.onclick=()=>{ THEME=THEME==='light'?'dark':'light'; try{ localStorage.setItem('cnas-dash-tema',THEME); }catch(e){} applyTheme(THEME); render(); };
const fS=document.getElementById('f-sub'), fSW=document.getElementById('f-sub-wrap');
const fAn=document.getElementById('f-an'), fP=document.getElementById('f-prog');
PLP.map((p,k)=>k).reverse().forEach(k=>fAn.append(el('option',{value:String(k),text:PLP[k].luni===12?PLP[k].an:`${PLP[k].an} (${PLP[k].eticheta.replace(' '+PLP[k].an,'')})`})));
fP.append(el('option',{value:'all',text:'Toate programele'}));
PROG.forEach(p=>fP.append(el('option',{value:p.id,text:p.nume})));
fAn.onchange=()=>{st.k=+fAn.value; render();};
fP.onchange=()=>{st.prog=fP.value; st.sub='all'; render();};
fS.onchange=()=>{st.sub=fS.value; render();};
function fillSub(){
  const show=hasSubs(st.prog); fSW.style.display=show?'':'none';
  if(fSW.dataset.p===st.prog) { fS.value=st.sub; return; }
  fSW.dataset.p=st.prog; fS.innerHTML=''; fS.append(el('option',{value:'all',text:'Toate subprogramele'}));
  if(show) subsOf(st.prog).forEach(k=>fS.append(el('option',{value:k,text:k})));
  fS.value=st.sub;
}
document.querySelectorAll('#tbl-mode button').forEach(b=>b.onclick=()=>{st.tbl=b.dataset.t; renderTable();});

// ---------- tooltip ----------
const tip=document.getElementById('tip');
function showTip(ev, title, rows){
  tip.innerHTML=''; tip.append(el('div',{class:'t',text:title}));
  rows.forEach((r,i)=>{
    if(i===0 && r.big){ tip.append(el('div',{class:'v',text:r.v})); if(r.l) tip.append(el('div',{class:'r'},[el('span',{text:r.l})])); return; }
    const k = r.c? el('i',{class:'k',style:`background:${r.c}`}):null;
    tip.append(el('div',{class:'r'},[el('span',{},[k,document.createTextNode(r.l)]),el('strong',{text:r.v})]));
  });
  tip.classList.add('on'); moveTip(ev);
}
function moveTip(ev){
  const x=ev.clientX, y=ev.clientY, w=tip.offsetWidth, h=tip.offsetHeight;
  let L=x+14, T=y+14; if(L+w>innerWidth-8) L=x-w-14; if(T+h>innerHeight-8) T=y-h-14;
  tip.style.left=Math.max(8,L)+'px'; tip.style.top=Math.max(8,T)+'px';
}
const hideTip=()=>tip.classList.remove('on');
function focusTip(node, title, rows){
  node.addEventListener('focus',()=>{const r=node.getBoundingClientRect();showTip({clientX:r.right,clientY:r.top},title,rows);});
  node.addEventListener('blur',hideTip);
}

// ---------- utilitare grafic ----------
function niceTicks(max, n=4){
  if(max<=0) return [0,1];
  const raw=max/n, p=Math.pow(10,Math.floor(Math.log10(raw))), m=raw/p;
  const step=(m<=1?1:m<=2?2:m<=2.5?2.5:m<=5?5:10)*p;
  const t=[]; for(let v=0; v<=max+step*0.001; v+=step) t.push(v); if(t[t.length-1]<max) t.push(t[t.length-1]+step); return t;
}
function axisLabel(v,maxv){
  if(maxv>=1e9) return fmtN(v/1e9, v%1e9===0?0:1)+' mld';
  if(maxv>=1e6) return fmtN(v/1e6,0)+' mil';
  if(maxv>=1e3) return fmtN(v/1e3,0)+' mii';
  return fmtN(v,0);
}
const scopeName=()=> (st.prog==='all'?'Toate programele':PNAME[st.prog]+(st.sub!=='all'?' – '+st.sub:'')) + ' · total național';
const shortM = v => v>=1e9 ? fmtN(v/1e9,2)+' mld' : (v>=1e8 ? fmtN(v/1e6,0)+' mil' : (v>=1e6 ? fmtN(v/1e6,1)+' mil' : fmtN(v/1e6,2)+' mil'));
function hatch(sv,col){ const id='h'+Math.random().toString(36).slice(2,8), defs=s('defs'), pat=s('pattern',{id,width:6,height:6,patternUnits:'userSpaceOnUse',patternTransform:'rotate(45)'});
  pat.append(s('rect',{width:6,height:6,fill:col,'fill-opacity':.22}),s('line',{x1:0,y1:0,x2:0,y2:6,stroke:col,'stroke-width':2.4})); defs.append(pat); sv.append(defs); return `url(#${id})`; }
const legHatch = col => `background-color:color-mix(in srgb, ${col} 22%, transparent);background-image:repeating-linear-gradient(135deg,${col} 0 2px,transparent 2px 5px)`;

// ---------- KPI ----------
function sparkSVG(vals, color){
  const w=240,h=36, mx=Math.max(...vals,1), mn=Math.min(...vals.filter(v=>v>0),mx);
  const sv=s('svg',{viewBox:`0 0 ${w} ${h}`,preserveAspectRatio:'none',class:'spark','aria-hidden':'true'});
  const X=i=>i*(w-6)/(Math.max(1,vals.length-1))+3, Y=v=>h-4-(v-mn*0.92)/(mx-mn*0.92||1)*(h-10);
  let d=''; vals.forEach((v,i)=>{d+=(i?'L':'M')+X(i).toFixed(1)+','+Y(v).toFixed(1);});
  sv.append(s('path',{d,fill:'none',stroke:'var(--axis)','stroke-width':1.5,'vector-effect':'non-scaling-stroke','stroke-linejoin':'round'}));
  const li=vals.length-1; sv.append(s('circle',{cx:X(li),cy:Y(vals[li]),r:3,fill:color}));
  return sv;
}
function kpi(id, lab, v, unitParts, meta, deltaV, deltaLbl, spark){
  const c=document.getElementById(id); c.innerHTML='';
  c.append(el('div',{class:'lab',text:lab}));
  const val_=el('div',{class:'val'},[document.createTextNode(unitParts?unitParts[0]:v)]); if(unitParts) val_.append(el('span',{class:'unit',text:unitParts[1]}));
  c.append(val_);
  const m=el('div',{class:'meta'});
  if(deltaV!=null && isFinite(deltaV)){ m.append(el('span',{class:'delta '+(deltaV>=0?'up':'down'),text:(deltaV>=0?'▲ ':'▼ ')+pct(deltaV)})); m.append(document.createTextNode(' '+deltaLbl)); }
  else if(meta) m.append(document.createTextNode(meta));
  c.append(m);
  if(deltaV!=null && isFinite(deltaV) && meta) c.append(el('div',{class:'meta',text:meta}));
  if(spark) c.append(spark);
}
function renderKPI(){
  const k=st.k, p=st.prog, sub=hasSubs(p)?st.sub:'all', pk=prevK(k);
  const cur=val(k,p,sub), pv=pk!=null?val(pk,p,sub):null;
  kpi('k1',`Total plăți · ${perL(k)}`,null,moneyParts(cur), '',
      pv>0?cur/pv-1:null, pv>0?`față de ${perL(pk)}`:'', sparkSVG(FULL.map(i=>val(i,p,sub)),'var(--accent)'));
  // k2: cost-volum (sau ponderea subprogramului)
  if(p!=='all' && sub!=='all'){
    kpi('k2',`Pondere în ${PNAME[p]}`,sh(cur/(pTot(k,p)||1)),null,pk!=null?`${perL(pk)}: ${sh(val(pk,p,sub)/(pTot(pk,p)||1))}`:'',null,'',null);
  } else if(hasCV(p)){
    const c=pCV(k,p), t=pTot(k,p), c0=pCV(K0,p), t0=pTot(K0,p);
    kpi('k2','din care cost-volum',null,moneyParts(c),`${sh(c/(t||1))} din plăți`+(k!==K0&&t0>0?` · ${PLP[K0].an}: ${sh(c0/t0)}`:''),null,'',null);
  } else {
    kpi('k2','Medie lunară',null,moneyParts(cur/PLP[k].luni),pv>0?`${perL(pk)}: ${money(pv/12)} / lună`:'Programul nu are medicamente în contracte cost-volum',null,'',null);
  }
  // k3: ponderea în total
  if(p==='all'){
    const parts=PID.map(q=>[q,pTot(k,q)]).sort((a,b)=>b[1]-a[1]), top3=parts.slice(0,3), t3=sum(top3.map(x=>x[1]));
    kpi('k3','Primele 3 programe',sh(t3/(cur||1)),null,top3.map(x=>PNAME[x[0]]).join(', ')+' – din total',null,'',null);
  } else {
    const tot=pTot(k,'all'), ptot=pk!=null?pTot(pk,'all'):0;
    kpi('k3',sub!=='all'?'Pondere în total plăți':`Pondere ${PNAME[p]} în total`,sh(cur/(tot||1)),null,ptot?`${perL(pk)}: ${sh(pv/ptot)}`:'',null,'',null);
  }
  // k4: creștere între primul an și anul selectat (sau ultimul an întreg)
  const kE = PLP[k].luni===12 ? k : KN, v0=val(K0,p,sub), v1=val(kE,p,sub), cg=cagrK(K0,kE,v0,v1);
  kpi('k4',`Creștere ${PLP[K0].an}–${PLP[kE].an}`, kE>K0&&v0>0?pct(v1/v0-1,0):'—', null, cg!=null?`Rată medie anuală: ${pct(cg)}`:'', null,'',null);
}

// ---------- evoluție anuală ----------
function renderTrend(){
  const box=document.getElementById('trend'); box.innerHTML='';
  const W=Math.max(320,box.clientWidth), H=W<640?250:300, m={l:56,r:12,t:24,b:30};
  const p=st.prog, split=!(p!=='all' && hasSubs(p) && st.sub!=='all'), col=colOf(p);
  const data=PLP.map((pp,k)=>{ const a=split?pProg(k,p):val(k,p,st.sub), b=split?pCV(k,p):0; return {pp,k,a,b,t:a+b}; });
  const anyCV=data.some(d=>d.b>0);
  const ticks=niceTicks(Math.max(...data.map(d=>d.t),1)), ymax=ticks[ticks.length-1];
  const n=data.length, band=(W-m.l-m.r)/n, bw=Math.min(70,band*0.56), Y=v=>m.t+(1-v/ymax)*(H-m.t-m.b);
  const sv=s('svg',{width:W,height:H,role:'img','aria-label':'Evoluția anuală a plăților, '+scopeName()});
  const hp=hatch(sv,col);
  const ax=s('g',{class:'ax'});
  ticks.forEach(t=>{ax.append(s('line',{x1:m.l,x2:W-m.r,y1:Y(t),y2:Y(t),class:t===0?'base':'gridl'})); const tx=s('text',{x:m.l-8,y:Y(t)+4,'text-anchor':'end'}); tx.textContent=axisLabel(t,ymax); ax.append(tx);});
  sv.append(ax);
  data.forEach(d=>{
    const x0=m.l+d.k*band, x=x0+(band-bw)/2, part=d.pp.luni<12, sel=d.k===st.k;
    if(sel) sv.append(s('rect',{x:x0+2,y:m.t-18,width:band-4,height:H-m.t-m.b+18,fill:'var(--accent-wash)',rx:6}));
    const op=part?0.5:1;
    if(d.a>0){ const y=Y(d.a), h=Y(0)-y; sv.append(s('rect',{x,y,width:bw,height:Math.max(1,h-(d.b>0?1:0)),fill:col,'fill-opacity':op,rx:d.b>0?0:3})); }
    if(d.b>0){ const y1=Y(d.t), y0=Y(d.a); sv.append(s('rect',{x,y:y1,width:bw,height:Math.max(1,y0-y1-1),fill:hp,stroke:col,'stroke-width':1.2,rx:3,opacity:part?0.6:1})); }
    const tv=s('text',{x:x+bw/2,y:Y(d.t)-6,'text-anchor':'middle','font-size':11,'font-weight':sel?700:500,fill:sel?'var(--ink)':'var(--ink-2)'}); tv.textContent=shortM(d.t); sv.append(tv);
    const tl=s('text',{x:x+bw/2,y:H-m.b+17,'text-anchor':'middle','font-size':11,'font-weight':sel?700:400,fill:sel?'var(--ink)':'var(--muted)'}); tl.textContent=perShort(d.k); sv.append(tl);
    const hit=s('rect',{x:x0,y:m.t-18,width:band,height:H-m.t-m.b+18,fill:'transparent',style:'cursor:pointer'});
    const pk=prevK(d.k), rows=[{big:true,v:money(d.t),l:scopeName()}];
    if(split && anyCV){ rows.push({l:'Plăți program',v:money(d.a)},{l:'Cost-volum',v:money(d.b)},{l:'Pondere cost-volum',v:sh(d.b/(d.t||1))}); }
    if(pk!=null && data[pk].t>0) rows.push({l:'Față de '+perL(pk),v:pct(d.t/data[pk].t-1)});
    if(part) rows.push({l:'Perioadă parțială',v:d.pp.luni+' luni'});
    hit.addEventListener('pointermove',e=>showTip(e,'Plăți · '+perL(d.k),rows)); hit.addEventListener('pointerleave',hideTip);
    hit.addEventListener('click',()=>{ st.k=d.k; hideTip(); renderAt('#trend'); });
    sv.append(hit);
  });
  box.append(sv);
  document.getElementById('trend-hint').textContent=`${scopeName()} · plăți efectuate (credite bugetare) · clic pe un an pentru a-l selecta`;
  const lg=document.getElementById('trend-leg'); lg.innerHTML='';
  const nm = p==='all'?'Programe':(split?PNAME[p]:st.sub);
  lg.append(el('span',{},[el('i',{style:`background:${col}`}),document.createTextNode(split&&anyCV?'Plăți '+(p==='all'?'programe':'program'):nm)]));
  if(split && anyCV) lg.append(el('span',{},[el('i',{style:legHatch(col)+`;box-shadow:inset 0 0 0 1.2px ${col}`}),document.createTextNode('Cost-volum')]));
}

// ---------- programe ----------
function renderProg(){
  const k=st.k, pk=prevK(k);
  const rows=PID.map(p=>({p,v:pTot(k,p),pv:pk!=null?pTot(pk,p):0})).filter(r=>r.v>0||r.pv>0).sort((a,b)=>b.v-a.v);
  const tot=sum(rows.map(r=>r.v)), mx=Math.max(...rows.map(r=>r.v),1);
  const box=document.getElementById('prog-rows'); box.innerHTML='';
  box.append(el('div',{class:'rows-h'},[el('div',{text:'Program'}),el('div',{text:''}),el('div',{text:'mil. lei'}),el('div',{text:'pond.'}),el('div',{text:pk!=null?'vs '+perL(pk):''})]));
  rows.forEach(r=>{
    const d=r.pv>0? r.v/r.pv-1:null;
    const row=el('div',{class:'row'+(st.prog===r.p?' sel':''),tabindex:0,role:'button','aria-expanded':st.prog===r.p,'data-p':r.p},[
      el('div',{class:'nm'},[el('i',{class:'sw',style:`background:${pcol(r.p)}`}),el('span',{text:PNAME[r.p],title:PFULL[r.p]}),el('span',{class:'chev','aria-hidden':'true',text:'▶'})]),
      el('div',{class:'track'},[el('div',{class:'bar',style:`width:${(r.v/mx*100).toFixed(2)}%;background:${pcol(r.p)}`})]),
      el('div',{class:'num',text:mil(r.v)}),
      el('div',{class:'num pct',text:sh(r.v/(tot||1))}),
      el('div',{class:'num delta '+(d==null?'':d>=0?'up':'down'),text:d==null?(pk!=null&&r.v>0?'nou':'—'):pct(d)})
    ]);
    const act=()=>{const on=st.prog!==r.p; st.prog= on?r.p:'all'; st.sub='all'; hideTip(); renderAt(`#prog-rows .row[data-p="${r.p}"]`); if(on) flashCards();};
    row.addEventListener('click',act); row.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();act();}});
    const tr=[{big:true,v:money(r.v),l:PFULL[r.p]}]; if(hasCV(r.p)) tr.push({l:'Plăți program',v:money(pProg(k,r.p))},{l:'Cost-volum',v:money(pCV(k,r.p))});
    tr.push({l:'Pondere în total',v:sh(r.v/(tot||1))}); if(pk!=null) tr.push({l:perL(pk),v:money(r.pv)});
    row.addEventListener('pointermove',e=>showTip(e,'Plăți · '+perL(k),tr)); row.addEventListener('pointerleave',hideTip);
    box.append(row);
    if(st.prog===r.p) box.append(progDetail(r.p,r.v,tot));
  });
  document.getElementById('prog-hint').textContent=`${perL(k)} · plăți program + cost-volum · clic pe un program pentru detalii; tot restul paginii se filtrează pe el`;
}
function progDetail(p,v,tot){
  const k=st.k, pk=prevK(k);
  const box=el('div',{class:'pdetail',style:`border-left-color:${pcol(p)==='var(--s0)'?'var(--axis)':pcol(p)}`});
  box.append(el('div',{class:'pd-h'},[el('strong',{text:PFULL[p]}),document.createTextNode(` · ${perL(k)} · plăți efectuate`)]));
  const stats=el('div',{class:'pd-stats'});
  const add=(b,a)=>stats.append(el('div',{},[el('b',{text:b}),document.createTextNode(a)]));
  add(money(v),'Total plăți'); if(hasCV(p)){ add(money(pProg(k,p)),'Plăți program'); add(money(pCV(k,p)),`Cost-volum (${sh(pCV(k,p)/(v||1))})`); }
  add(sh(v/(tot||1)),'Pondere în total');
  const cg=cagrK(K0,KN,pTot(K0,p),pTot(KN,p)); add(cg!=null?pct(cg)+' / an':'—',`Creștere medie ${PLP[K0].an}–${PLP[KN].an}`);
  const BPp=bolPerFor(st.an), bx=BPp&&BPp.date[p];
  if(bx && bx.b>0){ const lab=BPp.partial?BPp.eticheta:BPp.id; add(fmtI(bx.b),`Bolnavi tratați (${lab})`); const c=platiPeBolnav(BPp,p); if(c) add(fmtI(c)+' lei',`Cost mediu / pacient / ${BPp.partial?'S1':'an'} (${lab})`); }
  box.append(stats);
  box.append(el('div',{class:'pd-sec',text:'Evoluție anuală · mil. lei'}));
  const yrs=PLP.map((pp,i)=>({i,pp,v:pTot(i,p),c:pCV(i,p)}));
  const W=Math.min(520,Math.max(260,(document.getElementById('prog-rows').clientWidth||500)-40)), H=124, band=W/yrs.length, bw=Math.min(40,band*0.55), mx=Math.max(...yrs.map(y=>y.v),1);
  const sv=s('svg',{width:W,height:H,role:'img','aria-label':'Evoluția anuală a plăților '+PNAME[p]}), col=colOf(p), hp=hatch(sv,col);
  yrs.forEach(y=>{ const hT=y.v/mx*(H-46), hC=y.c/mx*(H-46), x=y.i*band+(band-bw)/2, yT=H-22-hT, part=y.pp.luni<12;
    if(y.v-y.c>0) sv.append(s('rect',{x,y:yT+hC,width:bw,height:Math.max(1,hT-hC),fill:col,'fill-opacity':part?0.45:1,rx:y.c>0?0:3}));
    if(y.c>0) sv.append(s('rect',{x,y:yT,width:bw,height:Math.max(1,hC-1),fill:hp,stroke:col,'stroke-width':1,rx:3,opacity:part?0.6:1}));
    const t=s('text',{x:x+bw/2,y:yT-5,'text-anchor':'middle','font-size':10.5,fill:'var(--ink-2)'}); t.textContent=y.v>=1e6?fmtN(y.v/1e6,y.v>=1e8?0:1):fmtN(y.v/1e6,2); sv.append(t);
    const t2=s('text',{x:x+bw/2,y:H-7,'text-anchor':'middle','font-size':10.5,fill:y.i===k?'var(--ink)':'var(--muted)','font-weight':y.i===k?700:400}); t2.textContent=perShort(y.i); sv.append(t2); });
  box.append(sv);
  if(hasSubs(p)){
    box.append(el('div',{class:'pd-sec',text:'Subprograme · clic pentru a filtra pagina pe subprogram'}));
    const it=subsOf(p).map(sb=>({k:sb,v:val(k,p,sb),pv:pk!=null?val(pk,p,sb):0})).filter(x=>x.v>0||x.pv>0).sort((a,b)=>b.v-a.v);
    const m2=Math.max(...it.map(x=>x.v),1);
    it.forEach((x,ix)=>{ const d=x.pv>0&&x.v>0?x.v/x.pv-1:null;
      const rr=el('div',{class:'row'+(st.sub===x.k?' sel':''),tabindex:0,role:'button','data-ki':String(ix)},[
        el('div',{class:'nm'},[el('span',{text:x.k,title:x.k})]),
        el('div',{class:'track'},[el('div',{class:'bar',style:`width:${Math.max(.3,x.v/m2*100).toFixed(2)}%;background:${pcol(p)}`})]),
        el('div',{class:'num',text:x.v>=1e5?mil(x.v):fmtN(x.v/1e6,3)}),
        el('div',{class:'num pct',text:sh(x.v/(v||1))}),
        el('div',{class:'num delta '+(d==null?'':d>=0?'up':'down'),text:d==null?'—':pct(d)})]);
      const a=e=>{e.stopPropagation(); st.sub=st.sub===x.k?'all':x.k; hideTip(); renderAt(`#prog-rows .pdetail .row[data-ki="${ix}"]`); flashCards();};
      rr.addEventListener('click',a); rr.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();a(e);}});
      box.append(rr); });
  }
  const go=id=>()=>document.getElementById(id).closest('.card').scrollIntoView({behavior:'smooth',block:'start'});
  box.append(el('div',{class:'pd-act'},[
    el('button',{class:'btn',type:'button',text:'Evoluția anuală ↑',onclick:go('trend')}),
    el('button',{class:'btn',type:'button',text:'Bolnavi ↓',onclick:go('bol-left')}),
    el('button',{class:'btn',type:'button',text:'Furnizori ↓',onclick:go('fz-map')}),
    el('button',{class:'btn',type:'button',text:'Tabel ↓',onclick:go('tbl')}),
    el('button',{class:'btn',type:'button',text:'× Închide și elimină filtrul',onclick:()=>{st.prog='all';st.sub='all';renderAt(`#prog-rows .row[data-p="${p}"]`);}})]));
  return box;
}

// ---------- structură (100%) ----------
function renderMix(){
  const box=document.getElementById('mix'); box.innerHTML='';
  const W=Math.max(300,box.clientWidth), H=290, m={l:6,r:6,t:6,b:38};
  const groups=[...COLORED,'_rest'];
  const data=PLP.map((pp,k)=>{const v={}; let t=0; PID.forEach(p=>{const x=pTot(k,p); const g=COLORED.includes(p)?p:'_rest'; v[g]=(v[g]||0)+x; t+=x;}); return {k,pp,v,t};});
  const sv=s('svg',{width:W,height:H,role:'img','aria-label':'Structura plăților pe ani'});
  const n=data.length, band=(W-m.l-m.r)/n, bw=Math.min(54,band*0.62), ph=H-m.t-m.b;
  data.forEach(d=>{
    const x=m.l+d.k*band+(band-bw)/2; let y=m.t+ph;
    groups.forEach(g=>{
      const v=d.v[g]||0; if(!v||!d.t) return; const h=v/d.t*ph, segH=Math.max(0,h-2);
      const r=s('rect',{x,y:y-h+2,width:bw,height:segH,fill:g==='_rest'?'var(--s0)':pcol(g),rx:2});
      r.addEventListener('pointermove',e=>showTip(e,perL(d.k),[{big:true,v:sh(v/d.t),l:g==='_rest'?'Celelalte programe':PNAME[g]},{l:'Plăți',v:money(v)}]));
      r.addEventListener('pointerleave',hideTip); sv.append(r);
      if(segH>=16 && bw>=36 && (g==='onco'||g==='diabet'||g==='dializa')){ const t=s('text',{x:x+bw/2,y:y-h/2+5,'text-anchor':'middle','font-size':11,'font-weight':600,fill:'#fff','pointer-events':'none'}); t.textContent=fmtN(v/d.t*100,0)+'%'; sv.append(t);}
      y-=h;
    });
    const t=s('text',{x:x+bw/2,y:H-m.b+16,'text-anchor':'middle',fill:d.k===st.k?'var(--ink)':'var(--muted)','font-size':11,'font-weight':d.k===st.k?700:400}); t.textContent=d.pp.an; sv.append(t);
    if(d.pp.luni<12){const t2=s('text',{x:x+bw/2,y:H-m.b+30,'text-anchor':'middle',fill:'var(--muted)','font-size':10}); t2.textContent=`${d.pp.luni} luni`; sv.append(t2);}
  });
  box.append(sv);
  const lg=document.getElementById('mix-leg'); lg.innerHTML='';
  groups.forEach(g=>lg.append(el('span',{},[el('i',{style:`background:${g==='_rest'?'var(--s0)':pcol(g)}`}),document.createTextNode(g==='_rest'?'Celelalte 10':PNAME[g])])));
}

// ---------- subprograme ----------
function renderSub(){
  const k=st.k, pk=prevK(k), p=st.prog;
  const box=document.getElementById('sub-rows'); box.innerHTML='';
  const sc=document.getElementById('sub-card'), cvc=document.getElementById('cv-card');
  sc.style.display = p==='all' ? 'none' : '';
  cvc.classList.toggle('c12', p==='all'); cvc.classList.toggle('c5', p!=='all');
  if(p==='all') return;
  let items=[];
  if(p==='all') PID.forEach(q=>{ const v=pTot(k,q), pv=pk!=null?pTot(pk,q):0; if(v>0||pv>0) items.push({p:q,k:PNAME[q],v,pv,prog:true}); });
  else subsOf(p).forEach(sb=>{ const v=val(k,p,sb), pv=pk!=null?val(pk,p,sb):0; if(v>0||pv>0) items.push({p,k:sb,v,pv}); });
  items.sort((a,b)=>b.v-a.v);
  const total=sum(items.map(i=>i.v));
  document.getElementById('sub-title').textContent = p==='all'?'Programele naționale curative':'Subprograme · '+PNAME[p];
  document.getElementById('sub-hint').textContent = `${perL(k)} · plăți efectuate` + (p!=='all'?' · clic pe un subprogram pentru a filtra pagina':' · clic pe un program pentru a-i vedea subprogramele');
  if(p!=='all' && !hasSubs(p)){ box.append(el('div',{class:'empty',text:`${PNAME[p]} nu are subprograme raportate separat în situația plăților.`})); return; }
  const mx=Math.max(...items.map(i=>i.v),1);
  box.append(el('div',{class:'rows-h'},[el('div',{text:p==='all'?'Program':'Subprogram'}),el('div'),el('div',{text:'mil. lei'}),el('div',{text:'pond.'}),el('div',{text:pk!=null?'vs '+perL(pk):''})]));
  items.forEach(it=>{
    const d=it.pv>0&&it.v>0?it.v/it.pv-1:null;
    const row=el('div',{class:'row'+(st.sub===it.k?' sel':''),tabindex:0,role:'button'},[
      el('div',{class:'nm'},[el('i',{class:'sw',style:`background:${pcol(it.p)}`}),el('span',{text:it.k,title:it.k})]),
      el('div',{class:'track'},[el('div',{class:'bar',style:`width:${Math.max(.3,it.v/mx*100).toFixed(2)}%;background:${pcol(it.p)}`})]),
      el('div',{class:'num',text:it.v>=1e5?mil(it.v):fmtN(it.v/1e6,3)}),
      el('div',{class:'num pct',text:sh(it.v/(total||1))}),
      el('div',{class:'num delta '+(d==null?'':d>=0?'up':'down'),text:d==null?(pk!=null&&!it.pv&&it.v>0?'nou':'—'):pct(d)})]);
    const tr=[{big:true,v:money(it.v),l:it.prog?PFULL[it.p]:it.k},{l:p==='all'?'Pondere în total':'Pondere în program',v:sh(it.v/(total||1))}]; if(pk!=null) tr.push({l:perL(pk),v:money(it.pv)});
    row.addEventListener('pointermove',e=>showTip(e,'Plăți · '+perL(k),tr)); row.addEventListener('pointerleave',hideTip);
    const act=it.prog ? ()=>{st.prog=it.p; st.sub='all'; hideTip(); renderAt('#sub-rows');} : ()=>{st.sub=st.sub===it.k?'all':it.k; hideTip(); renderAt('#sub-rows');};
    row.addEventListener('click',act); row.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();act();}});
    box.append(row);
  });
}

// ---------- cost-volum ----------
const CVMAP={'Oncologie – medicamente':'onco','Boli rare – HTAP':'rare','Boli rare – medicamente incluse condiționat':'rare','Boli rare – mucoviscidoză':'rare','Boli neurologice (scleroză multiplă)':'sm','Tulburare depresivă majoră':'mintal','Dializă':'dializa'};
function renderCV(){
  const card=document.getElementById('cv-card'); const k=st.k, p=st.prog;
  document.getElementById('cv-title').textContent='Cost-volum · '+(p==='all'?'toate programele':PNAME[p]);
  document.getElementById('cv-hint').textContent=`${perL(k)} · plăți cost-volum`;
  const right=document.getElementById('cv-right'); right.innerHTML='';
  if(!hasCV(p)){ right.append(el('div',{class:'empty',text:`${PNAME[p]} nu are medicamente în contracte cost-volum.`})); return; }
  const prog=pProg(k,p), cvv=pCV(k,p), T=prog+cvv;
  const sm=el('div',{class:'cv-sum'});
  [['Plăți program'+(p==='all'?'e':''),money(prog)],['Plăți cost-volum',money(cvv)],['Total plăți · '+perL(k),money(T),'tot'],['Ponderea cost-volum',sh(cvv/(T||1))]]
    .forEach(([a,b,c])=>{ sm.append(el('span',{class:c||'',text:a}),el('b',{class:c||'',text:b})); });
  right.append(sm);
  const det=Object.entries(CVP.det||{}).map(([l,v])=>({l,v:v[k]||0})).filter(x=>x.v>0 && (p==='all' || CVMAP[x.l]===p)).sort((a,b)=>b.v-a.v);
  if(det.length){
    const dd=el('div',{class:'cv-det'}); right.append(dd);
    dd.append(el('div',{class:'bol-sec',text:'Pe contracte · '+perL(k)}));
    const tot=sum(det.map(x=>x.v)), mx=Math.max(...det.map(x=>x.v),1);
    det.forEach(x=>dd.append(el('div',{class:'cv-row'},[el('span',{text:x.l}),el('div',{class:'track'},[el('div',{class:'bar',style:`width:${(x.v/mx*100).toFixed(2)}%;background:${pcol(CVMAP[x.l])}`})]),el('span',{class:'num',text:mil(x.v)}),el('span',{class:'num pct',text:sh(x.v/(tot||1))})])));
  }
}

// ---------- unități nominalizate (Normele tehnice – Ordinul CNAS nr. 180/2022) ----------
const FZ = D.furnizori || null;
const FZU = FZ ? FZ.unitati : [];
const nF = n => n===1?'furnizor':'furnizori';
const strip = t => String(t).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
const fzWords = t => strip(String(t).split('(')[0].split(' – ')[0]).split(/[\s\/–-]+/).filter(w=>w.length>3).map(w=>w.slice(0,6));
function fzSel(p, act){ // -> Map(unitIdx -> [activități])
  const m=new Map(); if(!FZ) return m;
  if(act && act.startsWith('sub:')) return m;   // subprogram fără listă nominală
  const progs = p==='all'? Object.keys(FZ.liste) : [p];
  progs.forEach(q=>(FZ.liste[q]||[]).forEach(g=>{ if(p!=='all' && act!=='all' && g.a!==act && !g.a.startsWith(act+' ›')) return;
    g.u.forEach(([i,det])=>{ if(!m.has(i)) m.set(i,[]); m.get(i).push({p:q,a:g.a,det}); }); }));
  return m;
}
function fzRenderList(){
  const box=document.getElementById('fz-rows'); if(!box||!FZ) return; box.innerHTML='';
  const p=st.prog, act=st.fzAct||'all', q=strip(st.fzQ||'');
  if(p==='all' && st.jud!=='all'){
    // toate programele + județ ales pe hartă: furnizorii din județ, cu programele fiecăruia
    const m=fzSel('all','all'), J=st.jud;
    const prs=i=>[...new Set(m.get(i).map(x=>x.p))].filter(x=>PNAME[x]).sort((a,b)=>PNAME[a].localeCompare(PNAME[b],'ro'));
    const inJ=[...m.keys()].filter(i=>FZU[i][2]===J);
    const ids=inJ.filter(i=>!q||strip(FZU[i][0]+' '+FZU[i][1]+' '+prs(i).map(x=>PNAME[x]).join(' ')).includes(q))
      .sort((a,b)=>prs(b).length-prs(a).length||FZU[a][0].localeCompare(FZU[b][0],'ro'));
    const back=el('button',{class:'btn fz-back',type:'button',text:'× '+JN[J]+' – înapoi la toate județele'});
    back.onclick=()=>{st.jud='all'; hideTip(); renderAt('#fz-card');};
    box.append(back);
    box.append(el('div',{class:'rows-h'},[el('div',{text:'Furnizori de servicii medicale'}),el('div',{text:'Localitate'}),el('div',{text:'Progr.',title:'Numărul de programe curative pentru care furnizorul este inclus'})]));
    ids.forEach(i=>{ const u=FZU[i], ps=prs(i);
      const row=el('div',{class:'row static'},[el('div',{class:'nm'},[el('span',{},[document.createTextNode(u[0]),el('span',{class:'sub2',text:ps.map(x=>PNAME[x]).join(' · ')})])]),
        el('div',{class:'num',text:u[1]}), el('div',{class:'num',text:String(ps.length)})]);
      const tr=ps.map(x=>{ const acts=[...new Set(m.get(i).filter(y=>y.p===x).map(y=>y.a))]; return {l:PNAME[x]+(acts.length>1||(acts[0]&&acts[0]!==PNAME[x])?': '+acts.join('; '):''),v:''}; });
      row.addEventListener('pointermove',e=>showTip(e,u[0],tr)); row.addEventListener('pointerleave',hideTip);
      box.append(row); });
    if(!inJ.length) box.append(el('div',{class:'empty',text:'În '+JN[J]+' nu există furnizori incluși nominal în programele curative; pacienții sunt tratați la furnizori din alte județe.'}));
    else if(!ids.length) box.append(el('div',{class:'empty',text:'Niciun furnizor nu corespunde căutării.'}));
    document.getElementById('fz-count').textContent=inJ.length?`${fmtN(ids.length,0)} din ${fmtN(inJ.length,0)} ${nF(inJ.length)} · ${JN[J]}`:JN[J];
    return;
  }
  if(p==='all'){
    const rows=Object.keys(FZ.liste).filter(x=>PNAME[x]).map(x=>{ const m=fzSel(x,'all'); const js=new Set([...m.keys()].map(i=>FZU[i][2]));
      return {x,n:m.size,j:js.size, inJ: st.jud!=='all'?[...m.keys()].filter(i=>FZU[i][2]===st.jud).length:null}; })
      .filter(r=>!q||strip(PNAME[r.x]).includes(q)).sort((a,b)=>b.n-a.n);
    box.append(el('div',{class:'rows-h'},[el('div',{text:'Program'}),el('div',{text:st.jud!=='all'?'Furnizori în '+JN[st.jud]:'Furnizori'}),el('div',{text:'Județe'})]));
    rows.forEach(r=>{ const row=el('div',{class:'row',tabindex:0,role:'button'},[
        el('div',{class:'nm'},[el('i',{class:'sw',style:`background:${pcol(r.x)}`}),el('span',{text:PNAME[r.x]})]),
        el('div',{class:'num',text:st.jud!=='all'?`${r.inJ} din ${r.n}`:fmtN(r.n,0)}), el('div',{class:'num',text:fmtN(r.j,0)})]);
      const go=()=>{st.prog=r.x; st.sub='all'; hideTip(); renderAt('#fz-card');};
      row.addEventListener('click',go); row.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go();}});
      box.append(row); });
    const tot=fzSel('all','all');
    document.getElementById('fz-count').textContent=`${fmtN(tot.size,0)} furnizori distincți în ${new Set([...tot.keys()].map(i=>FZU[i][2])).size} județe`;
    return;
  }
  const m=fzSel(p,act);
  let ids=[...m.keys()].filter(i=>st.jud==='all'||FZU[i][2]===st.jud).filter(i=>!q||strip(FZU[i][0]+' '+FZU[i][1]+' '+JN[FZU[i][2]]).includes(q));
  ids.sort((a,b)=>JN[FZU[a][2]].localeCompare(JN[FZU[b][2]],'ro')||FZU[a][0].localeCompare(FZU[b][0],'ro'));
  const LL=FZ.liste[p]||[];
  // „toate” sau un grup de activități (ex. Testare genetică – toate): coloana Activ. arată câte activități are furnizorul
  const many=(act==='all'&&LL.length>1) || (act!=='all' && !LL.some(g=>g.a===act) && LL.filter(g=>g.a.startsWith(act+' ›')).length>1);
  box.append(el('div',{class:'rows-h'},[el('div',{text:'Furnizori de servicii medicale'}),el('div',{text:'Județ'}),el('div',{text:many?'Activ.':'',title:'Număr de activități din program pentru care furnizorul este inclus'})]));
  ids.forEach(i=>{ const u=FZU[i], a=m.get(i), det=a.map(x=>x.det).filter(Boolean);
    const row=el('div',{class:'row static'},[el('div',{class:'nm'},[el('span',{},[document.createTextNode(u[0]),el('span',{class:'sub2',text:u[1]+(det.length&&!many?' · '+det.join('; '):'')})])]),
      el('div',{class:'num',text:JN[u[2]]}), el('div',{class:'num',text:many?String(a.length):''})]);
    const tr=a.map(x=>({l:(x.a||PNAME[x.p])+(x.det?' ('+x.det+')':''),v:''}));
    row.addEventListener('pointermove',e=>showTip(e,u[0],tr.length?tr:[{l:PNAME[p],v:''}])); row.addEventListener('pointerleave',hideTip);
    box.append(row); });
  if(!m.size){ box.innerHTML=''; document.getElementById('fz-count').textContent=''; return; }
  if(!ids.length) box.append(el('div',{class:'empty',text:'Niciun furnizor nu corespunde filtrelor (CAS / căutare).'}));
  document.getElementById('fz-count').textContent=`${fmtN(ids.length,0)} din ${fmtN(m.size,0)} ${nF(m.size)}`+(st.jud!=='all'?' · '+JN[st.jud]:'');
}
function renderFZ(){
  const card=document.getElementById('fz-card'); if(!FZ){ card.style.display='none'; return; }
  const p=st.prog;
  if(st.fzProg!==p){ st.fzProg=p; st.fzAct='all'; st.fzSub=null; }
  const lists0=p==='all'?[]:(FZ.liste[p]||[]);
  const prefixes=[...new Set(lists0.map(g=>g.a.split(' › ')[0]).filter(x=>lists0.filter(g=>g.a.startsWith(x+' ›')).length>1))];
  // sincronizare cu filtrul Subprogram (ex. Oncologie – Radioterapie)
  const fzS=(st.sub===CVL||st.sub===PRGL)?'all':st.sub;
  if(st.fzSub!==fzS){ st.fzSub=fzS;
    if(fzS && fzS!=='all'){ const W=fzWords(fzS), ok=t=>W.length&&W.every(w=>strip(t).includes(w));
      const gs=lists0.filter(g=>ok(g.a)), pre=prefixes.find(x=>ok(x));
      st.fzAct = pre || (gs.length===1?gs[0].a:(gs.length?gs[0].a.split(' › ')[0]:'sub:'+fzS)); }
    else st.fzAct='all'; }
  const lists=p==='all'?[]:(FZ.liste[p]||[]);
  const sel=document.getElementById('fz-act'), wrap=document.getElementById('fz-act-wrap');
  wrap.style.display=lists.length>1?'':'none'; sel.innerHTML='';
  if(lists.length>1){ const all=fzSel(p,'all');
    sel.append(el('option',{value:'all',text:`Toate activitățile (${all.size} ${nF(all.size)})`}));
    const cut=t=>t.length>80?t.slice(0,78)+'…':t;
    lists.forEach(g=>{ const pre=g.a.split(' › ')[0];
      if(prefixes.includes(pre) && !sel.querySelector(`option[value="${CSS.escape(pre)}"]`)) sel.append(el('option',{value:pre,text:`${cut(pre)} – toate (${fzSel(p,pre).size})`}));
      sel.append(el('option',{value:g.a,text:(prefixes.includes(pre)?'\u00a0\u00a0\u00a0':'')+`${cut(g.a)} (${g.u.length})`,title:g.a})); });
    sel.value=st.fzAct; sel.onchange=()=>{st.fzAct=sel.value; renderAt('#fz-card');}; }
  const m=fzSel(p,st.fzAct||'all');
  const byJ={}; m.forEach((a,i)=>{ const j=FZU[i][2]; byJ[j]=(byJ[j]||0)+1; });
  const nm=p==='all'?'toate programele':PNAME[p];
  document.getElementById('fz-title').textContent='Furnizori de servicii medicale aflați în relație contractuală cu CAS · '+nm;
  document.getElementById('fz-hint').textContent=st.fzAct&&st.fzAct!=='all'?st.fzAct.replace(/^sub:/,''):'';
  // hartă
  const box=document.getElementById('fz-map'); box.innerHTML='';
  const cls=n=>!n?-1:(n===1?0:n===2?1:n<=4?2:n<=9?3:4);
  const SEQ=['var(--fz1)','var(--fz2)','var(--fz3)','var(--fz4)','var(--fz5)'];
  const M=MAP, sv=s('svg',{viewBox:`0 0 ${M.w} ${M.h}`,width:'100%',role:'img','aria-label':'Harta furnizorilor de servicii medicale pe județe',style:'max-height:520px'});
  const front=s('g'), labels=s('g',{'pointer-events':'none'});
  const mk=(j,shape,lx,ly,code,fs)=>{
    const n=byJ[j]||0, k=cls(n);
    const g=s('g',{class:'cty'+(st.jud===j?' sel':''),tabindex:0,role:'button','aria-label':JN[j]+': '+n+' '+nF(n)});
    shape.setAttribute('fill',k<0?'var(--fz0)':SEQ[k]); g.append(shape);
    if(j==='BUCURESTI') g.append(s('circle',{cx:lx,cy:ly,r:15,fill:shape.getAttribute('fill'),stroke:'var(--fzstroke)','stroke-width':2.5,class:'bmk'}));
    const t=s('text',{x:lx,y:ly+fs*0.36,'text-anchor':'middle','font-size':fs,fill:`var(--fzl${k+1})`,'font-weight':n?600:400}); t.textContent=n?String(n):code; labels.append(t);
    const names=[...m.keys()].filter(i=>FZU[i][2]===j).map(i=>FZU[i][0]);
    const rows=[{big:true,v:n?`${n} ${n===1?'furnizor':'furnizori'}`:'niciun furnizor',l:nm}].concat(names.slice(0,8).map(x=>({l:x,v:''})));
    if(names.length>8) rows.push({l:`… încă ${names.length-8}`,v:''});
    g.addEventListener('pointermove',e=>showTip(e,JN[j],rows)); g.addEventListener('pointerleave',hideTip); focusTip(g,JN[j],rows);
    const act=()=>{st.jud=st.jud===j?'all':j; hideTip(); renderAt('#fz-card');};
    g.addEventListener('click',act); g.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();act();}});
    (st.jud===j||j==='BUCURESTI'?front:sv).append(g);
  };
  Object.entries(M.j).forEach(([j,o])=>{ if(j==='BUCURESTI') return; let [lx,ly]=o.c; if(LBL_OFF[j]){lx+=LBL_OFF[j][0];ly+=LBL_OFF[j][1];}
    mk(j,s('path',{d:o.d,'fill-rule':'evenodd'}),lx,ly,GRID[j]?GRID[j][2]:j.slice(0,2),17); });
  const b=M.j.BUCURESTI; mk('BUCURESTI',s('path',{d:b.d}),b.c[0],b.c[1],'B',13);
  sv.append(front); if(box.clientWidth>=480) sv.append(labels);
  if(m.size) box.append(sv); else box.append(el('div',{class:'empty',text:'Pentru această selecție nu există o listă nominală de furnizori; serviciile se acordă prin furnizorii aflați în contract cu casele de asigurări de sănătate.'}));
  document.querySelector('#fz-card .fz-tools').style.display=(p!=='all'&&!m.size)?'none':'';
  const qi=document.getElementById('fz-q'); qi.value=st.fzQ||''; qi.oninput=()=>{st.fzQ=qi.value; fzRenderList();};
  qi.placeholder=p==='all'&&st.jud==='all'?'Caută program':'Caută furnizor, localitate sau program';
  fzRenderList();
}
// ---------- bolnavi ----------
const BP = D.bolnavi || [];
const fmtI = v => v==null||!isFinite(v) ? 'n.r.' : new Intl.NumberFormat('ro-RO',{maximumFractionDigits:0}).format(v);
function bolPerFor(an){ return BP.find(p=>!p.partial && p.id===an) || BP.find(p=>p.partial && p.an===an) || null; }
function bolPrev(p){ if(!p||p.partial) return null; return BP.find(x=>!x.partial && x.id===String(+p.id-1)) || null; }
// lunile acoperite de o perioadă din centralizator (an întreg, sem. I, trim. I, 9 luni)
const bpLuni = P => !P.partial ? 12 : (/9 luni|trim\.\s*III/i.test(P.eticheta) ? 9 : (/sem\.\s*I(\s|$)/i.test(P.eticheta) ? 6 : (/trim\.\s*I(\s|$)/i.test(P.eticheta) ? 3 : NaN)));
// perioada de plăți care acoperă exact aceleași luni ca perioada de bolnavi
const kOfBP = P => P ? PLP.findIndex(pp=>pp.an===(P.partial?P.an:P.id) && pp.luni===bpLuni(P)) : -1;
function platiPeBolnav(P,p){ const k=kOfBP(P), x=P&&P.date[p]; if(k<0||!x||!(x.b>0)) return null; const v=pTot(k,p); return v>0? v/x.b : null; }
const cap = t => { t=String(t).trim(); return t.charAt(0).toLocaleUpperCase('ro-RO')+t.slice(1); };
function barMini(vals, labels, partial, fmt, pal, title, sel){
  const box=el('div'); box.append(el('div',{class:'bol-sec'},[el('span',{class:'pal',style:`background:linear-gradient(180deg,${pal[0]},${pal[1]})`}),document.createTextNode(title)]));
  const W=Math.max(260,Math.min(560,(document.getElementById('bol-left').clientWidth||520)/(innerWidth<640?1:2)-10)), H=158, n=vals.length, band=W/n, bw=Math.min(36,band*.6);
  const mx=Math.max(...vals.filter(v=>v!=null&&isFinite(v)),1);
  const sv=s('svg',{width:W,height:H,role:'img','aria-label':title});
  const gid='g'+Math.random().toString(36).slice(2,8), defs=s('defs'), lg=s('linearGradient',{id:gid,x1:0,y1:0,x2:0,y2:1});
  lg.append(s('stop',{offset:'0%',style:`stop-color:${pal[0]}`}),s('stop',{offset:'100%',style:`stop-color:${pal[1]}`})); defs.append(lg); sv.append(defs);
  sv.append(s('line',{x1:0,x2:W,y1:H-22,y2:H-22,stroke:'var(--axis)','stroke-width':1}));
  vals.forEach((v,i)=>{ const x=i*band+(band-bw)/2, on=i===sel;
    const t2=s('text',{x:x+bw/2,y:H-6,'text-anchor':'middle','font-size':10.5,fill:on?'var(--ink)':'var(--muted)','font-weight':on?700:400}); t2.textContent=labels[i]; sv.append(t2);
    if(v==null||!isFinite(v)){ const t=s('text',{x:x+bw/2,y:H-30,'text-anchor':'middle','font-size':10,fill:'var(--muted)'}); t.textContent='n.r.'; sv.append(t); return; }
    const h=Math.max(2,v/mx*(H-50)), y=H-22-h, rr=Math.min(5,h/2);
    const r=s('path',{d:`M${x},${H-22}V${y+rr}Q${x},${y} ${x+rr},${y}H${x+bw-rr}Q${x+bw},${y} ${x+bw},${y+rr}V${H-22}Z`,fill:`url(#${gid})`,'fill-opacity':partial[i]?0.45:1,stroke:on?pal[1]:'none','stroke-width':on?1.5:0});
    r.addEventListener('pointermove',e=>showTip(e,labels[i]+(partial[i]?' (perioadă parțială)':''),[{big:true,v:fmt(v),l:title}])); r.addEventListener('pointerleave',hideTip); sv.append(r);
    const t=s('text',{x:x+bw/2,y:y-6,'text-anchor':'middle','font-size':10.5,fill:on?'var(--ink)':'var(--ink-2)','font-weight':on?700:500}); t.textContent=fmt(v,true); sv.append(t);
  });
  box.append(sv); return box;
}
const compactI=(v,short)=> short && v>=1e4 ? fmtN(v/1e3, v>=1e5?0:1)+'k' : fmtI(v);
const compactL=(v,short)=> v>=1e6 ? fmtN(v/1e6, v>=1e7?1:2)+(short?' mil':' mil. lei') : fmtN(v/1e3,v>=1e5?0:1)+(short?' mii':' mii lei');
function renderBolnavi(){
  const card=document.getElementById('bol-card'); if(!BP.length){ card.style.display='none'; return; }
  const P=bolPerFor(st.an)||BP[BP.length-1], Pv=bolPrev(P);
  const L=document.getElementById('bol-left'), Rt=document.getElementById('bol-right'); L.innerHTML=''; Rt.innerHTML='';
  const pp=document.getElementById('bol-per'); pp.innerHTML='';
  BP.forEach(x=>{ const b=el('button',{type:'button',class:(x===P?'on':''),text:x.partial?x.eticheta.replace('sem. I','S1'):x.id});
    b.onclick=()=>{ const k=kOfBP(x); if(k>=0){ st.k=k; renderAt('#bol-card'); } }; pp.append(b); });
  const per = P.partial? P.eticheta : 'anul '+P.id;
  document.getElementById('bol-hint').textContent = `${cap(per)} · date naționale`;
  if(st.prog==='all'){
    document.getElementById('bol-title').textContent='Bolnavi tratați pe programe';
    const rows=PID.map(p=>({p,x:P.date[p],px:Pv?Pv.date[p]:null})).filter(r=>r.x).sort((a,b)=>(b.x.b||0)-(a.x.b||0));
    const mx=Math.max(...rows.map(r=>r.x.b||0),1);
    L.append(el('div',{class:'rows-h'},[el('div',{text:'Program'}),el('div'),el('div',{text:'bolnavi'}),el('div',{text:P.partial?'cost mediu / pacient / S1':'cost mediu / pacient / an'}),el('div',{text:Pv?'vs '+Pv.id:''})]));
    rows.forEach(r=>{ const d=r.px&&r.px.b>0&&r.x.b>0? r.x.b/r.px.b-1:null; const c=platiPeBolnav(P,r.p);
      const row=el('div',{class:'row',tabindex:0,role:'button','data-bp':r.p},[
        el('div',{class:'nm'},[el('i',{class:'sw',style:`background:${pcol(r.p)}`}),el('span',{text:PNAME[r.p],title:PFULL[r.p]})]),
        el('div',{class:'track'},[el('div',{class:'bar',style:`width:${((r.x.b||0)/mx*100).toFixed(2)}%;background:${pcol(r.p)}`})]),
        el('div',{class:'num',text:fmtI(r.x.b)}),
        el('div',{class:'num',text:c?fmtI(c):'—'}),
        el('div',{class:'num delta '+(d==null?'':d>=0?'up':'down'),text:d!=null?pct(d):(!Pv&&!P.partial?'':'—')})]);
      const k=kOfBP(P), tr=[{big:true,v:fmtI(r.x.b)+' bolnavi',l:PFULL[r.p]}]; if(k>=0) tr.push({l:'Plăți (program + cost-volum)',v:money(pTot(k,r.p))}); tr.push({l:P.partial?'Cost mediu / pacient / S1':'Cost mediu / pacient / an',v:c?fmtI(c)+' lei':'—'}); if(r.px) tr.push({l:'Bolnavi '+Pv.id,v:fmtI(r.px.b)});
      row.addEventListener('pointermove',e=>showTip(e,per,tr)); row.addEventListener('pointerleave',hideTip);
      const act=()=>{st.prog=r.p; st.sub='all'; hideTip(); renderAt(`#bol-left .row[data-bp="${r.p}"]`)}; row.addEventListener('click',act); row.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();act();}});
      L.append(row); });
    // indicațiile cu cei mai mulți bolnavi
    const all=[]; PID.forEach(p=>{const x=P.date[p]; if(!x) return; x.ind.forEach(i=>{ if(i[1]>=1 && i[1]!==x.b) all.push({p,n:i[0],b:i[1]}); });});  // fără rândurile egale cu totalul programului
    all.sort((a,b)=>b.b-a.b);
    Rt.append(el('div',{class:'bol-sec',text:'Indicațiile cu cei mai mulți bolnavi'}));
    Rt.append(el('div',{class:'rows-h'},[el('div',{text:'Indicație'}),el('div',{text:''}),el('div',{text:P.partial?'Bolnavi/Sem. I':'Bolnavi/An'})]));
    all.slice(0,12).forEach(a=>{ Rt.append(el('div',{class:'row static'},[
      el('div',{class:'nm'},[el('i',{class:'sw',style:`background:${pcol(a.p)}`}),el('span',{},[document.createTextNode(cap(a.n)),el('span',{class:'sub2',text:PNAME[a.p]})])]),
      el('div',{class:'num',text:''}), el('div',{class:'num',text:fmtI(a.b)})])); });
  } else {
    const p=st.prog;
    document.getElementById('bol-title').textContent='Bolnavi tratați · '+PNAME[p];
    const labs=BP.map(x=>x.partial?x.eticheta.replace('sem. I ','S1 '):x.id), part=BP.map(x=>x.partial);
    const bs=BP.map(x=>x.date[p]?x.date[p].b:null), cs=BP.map(x=>platiPeBolnav(x,p));
    const col=colOf(p);
    const ch=el('div',{class:'bol-charts'});
    const iSel=BP.indexOf(P);
    ch.append(barMini(bs,labs,part,compactI,['var(--pat1)','var(--pat2)'],'Număr de bolnavi',iSel), barMini(cs,labs,part,(v,sh_)=>sh_?compactL(v,true):fmtI(v)+' lei',['var(--cost1)','var(--cost2)'],'Cost mediu / pacient / an (lei)',iSel));
    L.append(ch);
    const x=P.date[p];
    if(x){ const px=Pv?Pv.date[p]:null; const d=px&&px.b>0&&x.b>0?x.b/px.b-1:null, k=kOfBP(P), c=platiPeBolnav(P,p);
      const it=x.ind.filter(i=>i[1]>0).map(i=>({n:i[0],b:i[1]})).sort((a,b)=>b.b-a.b);
      Rt.append(el('div',{class:'bol-sec',text:`Indicații · ${per} (după numărul de bolnavi)`}));
      Rt.append(el('div',{class:'rows-h'},[el('div',{text:'Indicație'}),el('div',{text:''}),el('div',{text:'bolnavi'})]));
      const show=st.bolAll?it:it.slice(0,12);
      show.forEach(a=>{ Rt.append(el('div',{class:'row static'},[el('div',{class:'nm'},[el('span',{text:cap(a.n)})]), el('div',{class:'num',text:''}), el('div',{class:'num',text:fmtI(a.b)})])); });
      if(it.length>12){ const b=el('button',{class:'btn',type:'button',style:'margin-top:8px',text:st.bolAll?'Arată primele 12':`Arată toate (${it.length})`}); b.onclick=()=>{st.bolAll=!st.bolAll; renderAt('#bol-card');}; Rt.append(b); }
    } else { Rt.append(el('div',{class:'empty',text:`Programul nu apare în centralizatorul pentru ${per}.`})); }
  }
}

// ---------- tabel ----------
function renderTable(){
  const p=st.prog, bySub=hasSubs(p);
  const mode=st.tbl||'tot';
  const tg=document.getElementById('tbl-mode'); tg.style.display=p==='all'?'':'none';
  tg.querySelectorAll('button').forEach(b=>b.classList.toggle('on',b.dataset.t===mode));
  const F = p==='all' ? (mode==='prog'?pProg:(mode==='cv'?pCV:pTot)) : null;
  const defs = p==='all' ? PID.map(q=>({p:q,label:PNAME[q],v:PLP.map((x,k)=>F(k,q))}))
             : bySub ? subsOf(p).map(sb=>({p,label:sb,v:PLP.map((x,k)=>val(k,p,sb))}))
             : [{p,label:PNAME[p],v:PLP.map((x,k)=>pTot(k,p))}];
  const tv = p==='all' ? PLP.map((x,k)=>F(k,'all')) : PLP.map((x,k)=>pTot(k,p));
  const head=[bySub?'Subprogram · '+PNAME[p]:'Program',...PLP.map(x=>x.luni===12?x.an:x.eticheta)];
  const t=document.getElementById('tbl'); t.innerHTML='';
  t.append(el('thead',{},el('tr',{},head.map(h=>el('th',{text:h})))));
  const cell=(arr,k)=>{ const v=arr[k], pk=prevK(k); const y=pk!=null&&arr[pk]>0&&v>0?v/arr[pk]-1:null; return el('td',{},[document.createTextNode(v?mil(v):'–'),y!=null?el('span',{class:'yoy',text:pct(y)}):null]); };
  const tb=el('tbody');
  defs.filter(r=>r.v.some(x=>x>0)).sort((a,b)=>b.v[st.k]-a.v[st.k]).forEach(r=>{
    const tr=el('tr',{},[el('td',{},[el('i',{class:'sw',style:`display:inline-block;margin-right:8px;background:${pcol(r.p)}`}),document.createTextNode(r.label)])]);
    PLP.forEach((x,k)=>tr.append(cell(r.v,k))); tb.append(tr); });
  t.append(tb);
  if(p==='all' || bySub){ const ft=el('tr',{},[el('td',{text:p==='all'?'Total':'Total '+PNAME[p]})]); PLP.forEach((x,k)=>ft.append(cell(tv,k))); t.append(el('tfoot',{},ft)); }
  document.getElementById('tbl-title').textContent=(bySub?'Tabel subprogram × an':'Tabel program × an')+' · plăți efectuate';
  const what = p==='all' ? (mode==='prog'?'plăți program (fără cost-volum)':(mode==='cv'?'plăți cost-volum':'plăți program + cost-volum')) : 'plăți program + cost-volum';
  document.getElementById('tbl-hint').textContent=`Milioane lei · ${what} · total național`;
}

// ---------- descărcare CSV (separator „;”, zecimale cu virgulă, UTF-8 cu BOM – se deschide direct în Excel / LibreOffice) ----------
function dlCSV(name, rows){
  const esc=v=>{ if(v==null||(typeof v==='number'&&!isFinite(v))) return ''; let t=typeof v==='number'? String(Math.round(v*100)/100).replace('.',',') : String(v);
    if(/[";\r\n]/.test(t)) t='"'+t.replace(/"/g,'""')+'"'; return t; };
  const txt='﻿'+rows.map(r=>r.map(esc).join(';')).join('\r\n');
  const url=URL.createObjectURL(new Blob([txt],{type:'text/csv;charset=utf-8'}));
  const a=document.createElement('a'); a.href=url; a.download=name; document.body.append(a); a.click();
  setTimeout(()=>{URL.revokeObjectURL(url); a.remove();},1500);
}
const fileTag = t => strip(t).replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'');
const perCol = k => PLP[k].luni===12 ? PLP[k].an : PLP[k].eticheta;
function csvTable(){
  const p=st.prog, bySub=hasSubs(p), mode=st.tbl||'tot';
  const F = p==='all' ? (mode==='prog'?pProg:(mode==='cv'?pCV:pTot)) : null;
  const what = p==='all' ? (mode==='prog'?'Plăți program (fără cost-volum)':(mode==='cv'?'Plăți cost-volum':'Plăți program + cost-volum')) : 'Plăți program + cost-volum';
  const rows=[[bySub?'Subprogram ('+PNAME[p]+')':'Program',...PLP.map((x,k)=>perCol(k)+' (lei)')]];
  const defs = p==='all' ? PID.map(q=>[PNAME[q],...PLP.map((x,k)=>F(k,q))])
             : bySub ? subsOf(p).map(sb=>[sb,...PLP.map((x,k)=>val(k,p,sb))])
             : [[PNAME[p],...PLP.map((x,k)=>pTot(k,p))]];
  defs.filter(r=>r.slice(1).some(v=>v>0)).forEach(r=>rows.push(r));
  if(p==='all'||bySub) rows.push([p==='all'?'Total':'Total '+PNAME[p],...PLP.map((x,k)=>p==='all'?F(k,'all'):pTot(k,p))]);
  rows.push([]); rows.push(['Indicator: '+what+' · plăți efectuate (credite bugetare) · total național · lei']);
  dlCSV(`plati_${p==='all'?'programe_'+mode:fileTag(PNAME[p])}.csv`, rows);
}
function csvBol(){
  const p=st.prog, lab=x=>x.partial?x.eticheta:x.id;
  let rows;
  if(p==='all'){
    rows=[['Program',...BP.flatMap(x=>[`Bolnavi ${lab(x)}`,`Cost mediu / pacient ${lab(x)} (lei)`])]];
    PID.forEach(q=>{ if(!BP.some(x=>x.date[q])) return; rows.push([PNAME[q],...BP.flatMap(x=>{ const d=x.date[q]; const c=d?platiPeBolnav(x,q):null; return [d?d.b:null, c!=null?Math.round(c):null]; })]); });
  } else {
    const names=[]; BP.forEach(x=>((x.date[p]||{}).ind||[]).forEach(i=>{ if(!names.includes(i[0])) names.push(i[0]); }));
    rows=[['Indicație ('+PNAME[p]+')',...BP.map(x=>`Bolnavi ${lab(x)}`)]];
    rows.push(['Total program',...BP.map(x=>x.date[p]?x.date[p].b:null)]);
    rows.push(['Cost mediu / pacient (lei)',...BP.map(x=>{ const c=platiPeBolnav(x,p); return c!=null?Math.round(c):null; })]);
    names.forEach(n=>rows.push([cap(n),...BP.map(x=>{ const i=((x.date[p]||{}).ind||[]).find(y=>y[0]===n); return i?i[1]:null; })]));
  }
  rows.push([]); rows.push(['Bolnavi tratați: centralizatoarele de indicatori CNAS · cost mediu / pacient = plățile perioadei (program + cost-volum) / bolnavi']);
  dlCSV(`bolnavi_${p==='all'?'programe':fileTag(PNAME[p])}.csv`, rows);
}
function csvFz(){
  if(!FZ) return;
  const p=st.prog, act=p==='all'?'all':(st.fzAct||'all'), m=fzSel(p,act), q=strip(st.fzQ||'');
  const rows=[['Furnizor','Localitate','Județ','Program','Activitate','Detalii']];
  [...m.keys()].filter(i=>st.jud==='all'||FZU[i][2]===st.jud)
    .sort((a,b)=>JN[FZU[a][2]].localeCompare(JN[FZU[b][2]],'ro')||FZU[a][0].localeCompare(FZU[b][0],'ro'))
    .forEach(i=>{ const u=FZU[i]; m.get(i).forEach(x=>{ const row=[u[0],u[1]||'',JN[u[2]],PNAME[x.p]||x.p,x.a||'',x.det||''];
      if(!q || strip(row.join(' ')).includes(q)) rows.push(row); }); });
  const tag = (p==='all'?'toate_programele':fileTag(PNAME[p])) + (st.jud!=='all'?'_'+fileTag(JN[st.jud]):'');
  dlCSV(`furnizori_${tag}.csv`, rows);
}
document.getElementById('csv-tbl').onclick=csvTable;
document.getElementById('csv-bol').onclick=csvBol;
document.getElementById('csv-fz').onclick=csvFz;

// ---------- bara de sus fixă ----------
const TB=document.getElementById('topbar'), TS=document.getElementById('topspace');
function fitTop(){ if(!TB.classList.contains('compact')) TS.style.height=TB.offsetHeight+'px'; else document.documentElement.style.setProperty('--hdrc',TB.offsetHeight+'px'); }
let tbCompact=false;
function onScrollTop(){ const c = tbCompact ? scrollY>4 : scrollY>48; if(c!==tbCompact){ tbCompact=c; TB.classList.toggle('compact',c); } }
addEventListener('scroll',onScrollTop,{passive:true});
if(window.ResizeObserver) new ResizeObserver(fitTop).observe(TB); else addEventListener('resize',fitTop);
// păstrează poziția elementului pe care s-a dat clic (bara de filtre își poate schimba înălțimea)
function renderAt(selector){
  const e=selector&&document.querySelector(selector); const y=e?e.getBoundingClientRect().top:null;
  render();
  if(y!=null){ const n=document.querySelector(selector); if(n) window.scrollBy(0,n.getBoundingClientRect().top-y); }
}
function flashCards(){ if(matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  ['k1','trend'].forEach(id=>{const c=document.getElementById(id); const card=c.closest('.card'); card.classList.remove('flash'); void card.offsetWidth; card.classList.add('flash');}); }
// ---------- render ----------
function render(){
  fAn.value=String(st.k); fP.value=st.prog;
  fillSub();
  const last=PLP[NK-1];
  // doar pentru perioada parțială (anul în curs) are sens să se precizeze până când sunt plățile
  document.getElementById('scope').textContent=(last && st.k===NK-1 && last.luni<12)?`Plăți până la ${LUNI[last.luni-1]} ${last.an}`:'';
  renderKPI(); renderTrend(); renderProg(); renderMix(); renderFZ(); renderSub(); renderCV(); renderBolnavi(); renderTable();
}
render(); fitTop(); onScrollTop();
let rt; addEventListener('resize',()=>{clearTimeout(rt); rt=setTimeout(()=>{renderTrend();renderMix();renderBolnavi();renderFZ();},120);});
})();
</script>
